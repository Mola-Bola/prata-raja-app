    desc: '+1 revive per run; revive at 50% HP',
    maxLevel: 2,
    perLevel: { revives: 1 },
    sprite: 'passives/second-helping',
  },
};
import type { Rng } from '../core/rng';
import { rollItem } from './gear';
import { RARITIES, type ChestPity, type GearItem, type Rarity } from './types';

/** Cadence counters do not reset on a lucky natural drop. Every twentieth also satisfies fifth-chest pity. */
export function rollChest(rng: Rng, pity: ChestPity, minRarity: Rarity = 'common'): { item: GearItem; pity: ChestPity } {
  const rare = pity.rare + 1;
  const epic = pity.epic + 1;
  const minimum = RARITIES[Math.max(RARITIES.indexOf(minRarity), epic >= 20 ? 3 : rare >= 5 ? 2 : 0)];
  return {
    item: rollItem(rng, { source: 'chest', minRarity: minimum }),
    pity: { rare: rare % 5, epic: epic % 20, opened: pity.opened + 1 },
  };
}
import type { Rng } from '../core/rng';
import { BASE_STATS } from '../core/stats';
import type { PlayerStats } from '../core/types';
import { RARITIES, type Affix, type GearBaseId, type GearItem, type Rarity, type SaveV2, type Slot } from './types';

export const GEAR_BASES: Record<GearBaseId, Slot> = {
  'faded-kopitiam-towel': 'towel', 'sweat-stained-towel': 'towel', 'lucky-red-towel': 'towel',
  'plain-headband': 'headband', 'stall-bandana': 'headband', 'cooks-hairnet': 'headband',
  'cotton-apron': 'apron', 'oil-splashed-apron': 'apron', 'denim-apron': 'apron',
  'oven-gloves': 'gloves', 'silicone-gloves': 'gloves', 'chefs-gloves': 'gloves',
  'rubber-flip-flops': 'slippers', 'kitchen-clogs': 'slippers', 'old-house-slippers': 'slippers',
};
export const RARITY_INFO: Record<Rarity, { color: string; multiplier: number; affixes: number; weight: number }> = {
  common: { color: '#9CA3AF', multiplier: 1, affixes: 0, weight: 600 },
  uncommon: { color: '#4ADE80', multiplier: 1.3, affixes: 0, weight: 250 },
  rare: { color: '#60A5FA', multiplier: 1.7, affixes: 1, weight: 100 },
  epic: { color: '#C084FC', multiplier: 2.2, affixes: 2, weight: 40 },
  legendary: { color: '#FB923C', multiplier: 3, affixes: 3, weight: 9 },
  raja: { color: '#FACC15', multiplier: 4.5, affixes: 4, weight: 1 },
};
const affix = (id: string, stat: keyof PlayerStats, value: number): Affix => ({ id, stat, value });
// shortcut: only unconditional PlayerStats affixes; add combat triggers when the simulation supports them.
export const AFFIX_POOLS: Record<Slot, readonly Affix[]> = {
  towel: [affix('gold-tips', 'goldPct', .1), affix('crit-power', 'critMult', .1), affix('lucky', 'critChance', .01), affix('keen-eye', 'rangePct', .05)],
  headband: [affix('strong-wrist', 'dmgPct', .05), affix('sharp-eye', 'critChance', .01), affix('hot-tawa', 'dotPct', .05), affix('long-throw', 'rangePct', .05)],
  apron: [affix('padded', 'dmgTakenPct', -.03), affix('mending', 'regen', .2), affix('sturdy', 'maxHp', 5), affix('nimble', 'dodge', .02)],
  gloves: [affix('fast-flip', 'throwSpeedPct', .03), affix('firm-grip', 'dmgPct', .03), affix('big-dough', 'sizePct', .05), affix('precise', 'critChance', .01)],
  slippers: [affix('dodge', 'dodge', .05), affix('quick-feet', 'moveSpeed', BASE_STATS.moveSpeed * .03), affix('steady', 'dmgTakenPct', -.02), affix('restful', 'regen', .1)],
};
const MAIN_STATS: Record<Slot, Partial<PlayerStats>> = {
  towel: { critChance: .02 }, headband: { dmgPct: .03 }, apron: { maxHp: 5 },
  gloves: { throwSpeedPct: .03 }, slippers: { moveSpeed: BASE_STATS.moveSpeed * .03 },
};

export type RollOptions = { baseId?: GearBaseId; slot?: Slot; rarity?: Rarity; minRarity?: Rarity; source?: 'drop' | 'chest' | 'boss'; uid?: string };
export function rollItem(rng: Rng, opts: RollOptions = {}): GearItem {
  const max = opts.source === 'chest' || opts.source === 'boss' ? 5 : 2;
  const min = RARITIES.indexOf(opts.minRarity ?? 'common');
  if (min > max || (opts.rarity && RARITIES.indexOf(opts.rarity) > max)) throw new Error('Epic+ requires a chest or boss');
  if (opts.rarity && RARITIES.indexOf(opts.rarity) < min) throw new Error('Rarity is below minimum');
  if (opts.baseId && opts.slot && GEAR_BASES[opts.baseId] !== opts.slot) throw new Error('Base does not match slot');
  const rarity = opts.rarity ?? rng.weighted(RARITIES.slice(min, max + 1), r => RARITY_INFO[r].weight);
  const bases = (Object.keys(GEAR_BASES) as GearBaseId[]).filter(id => !opts.slot || GEAR_BASES[id] === opts.slot);
  const baseId = opts.baseId ?? rng.pick(bases);
  const slot = GEAR_BASES[baseId];
  const pool = [...AFFIX_POOLS[slot]];
  const affixes: Affix[] = [];
  for (let i = 0; i < RARITY_INFO[rarity].affixes; i++) affixes.push({ ...pool.splice(rng.int(0, pool.length - 1), 1)[0] });
  return { uid: opts.uid ?? `${rng.int(0, 0xffffffff).toString(16)}-${rng.int(0, 0xffffffff).toString(16)}`, baseId, slot, rarity, level: 1, affixes };
}

/** Three distinct items; research caps merge output at Rare. Keeps the lowest input level. */
export function merge3(items: readonly GearItem[], rng: Rng): GearItem | null {
  const first = items[0];
  if (items.length !== 3 || new Set(items.map(i => i.uid)).size !== 3 || !first ||
      !['common', 'uncommon'].includes(first.rarity) ||
      items.some(i => i.baseId !== first.baseId || i.rarity !== first.rarity || i.slot !== GEAR_BASES[i.baseId])) return null;
  const merged = rollItem(rng, { baseId: first.baseId, rarity: RARITIES[RARITIES.indexOf(first.rarity) + 1] });
  return { ...merged, level: Math.min(...items.map(i => i.level)) };
}

/** Cost to go from the current level to the next: 40, 60, 90, … coins. */
export function upgradeCost(item: Pick<GearItem, 'level'>): number {
  return Math.ceil(40 * 1.5 ** (item.level - 1));
}
export function upgradeItem(save: SaveV2, uid: string): SaveV2 {
  const item = save.inventory.find(i => i.uid === uid);
  if (!save.unlocks.gear || !item || save.gold < upgradeCost(item) || !Number.isFinite(upgradeCost(item))) return save;
  return { ...save, gold: save.gold - upgradeCost(item), inventory: save.inventory.map(i => i.uid === uid ? { ...i, level: i.level + 1 } : i) };
}
/** Puts an owned item in its slot, replacing the old one. Locked gear or locked slots are refused. */
export function equipItem(save: SaveV2, uid: string): SaveV2 {
  const item = save.inventory.find(i => i.uid === uid);
  if (!item || !save.unlocks.gear || !save.unlocks[item.slot]) return save;
  return { ...save, equipped: { ...save.equipped, [item.slot]: uid } };
}
export function itemStats(item: GearItem): Partial<PlayerStats> {
  const stats: Partial<PlayerStats> = {};
  const multiplier = RARITY_INFO[item.rarity].multiplier * (1 + .1 * (item.level - 1));
  for (const [key, value] of Object.entries(MAIN_STATS[item.slot])) stats[key as keyof PlayerStats] = value * multiplier;
  for (const a of item.affixes) stats[a.stat] = (stats[a.stat] ?? 0) + a.value;
  return stats;
}
import { stallLevel } from './stall';
import type { SaveV2 } from './types';

const HOUR_MS = 3_600_000;
const CAP_HOURS = 12;

/** Integer ms times coins/hour, so rounding never drops a coin (floats gave 122 where 123 is owed). */
function accrued(save: SaveV2, now: Date) {
  const rate = 20 + 2 * (stallLevel(save.stallXp) - 1);
  const elapsed = save.idle.lastCollectedAt ? now.getTime() - Date.parse(save.idle.lastCollectedAt) : 0;
  const ms = Number.isFinite(elapsed) ? Math.min(CAP_HOURS * HOUR_MS, Math.max(0, elapsed)) : 0;
  return { rate, ms, gold: Math.floor((ms * rate) / HOUR_MS) };
}
export function preview(save: SaveV2, now: Date): { gold: number; hours: number; rate: number; capHours: number } {
  const { rate, ms, gold } = accrued(save, now);
  return { gold, hours: ms / HOUR_MS, rate, capHours: CAP_HOURS };
}
export function collect(save: SaveV2, now: Date): { save: SaveV2; rewards: ReturnType<typeof preview> } {
  const rewards = preview(save, now);
  if (!Number.isFinite(now.getTime()) || (save.idle.lastCollectedAt && now.getTime() < Date.parse(save.idle.lastCollectedAt))) return { save, rewards };
  // Keep the sub-coin time (ms) for the next collect; time above the printed cap is discarded.
  const { rate, ms, gold } = accrued(save, now);
  const keptMs = ms >= CAP_HOURS * HOUR_MS ? 0 : (ms * rate - gold * HOUR_MS) / rate;
  return { save: { ...save, gold: save.gold + gold, idle: { lastCollectedAt: new Date(now.getTime() - keptMs).toISOString() } }, rewards };
}
import type { Content, Loadout, PlayerStats } from '../core/types';
import { itemStats } from './gear';
import { trainingStats } from './training';
import { SLOTS, type SaveV2 } from './types';

/** Returns additive bonuses, not BASE_STATS (the simulation adds those). */
export function computeLoadout(save: SaveV2, content: Content): Loadout {
  const stats = save.unlocks.training ? trainingStats(save.training) : {};
  for (const slot of SLOTS) {
    if (!save.unlocks.gear || !save.unlocks[slot]) continue;
    const item = save.inventory.find(i => i.uid === save.equipped[slot] && i.slot === slot);
    if (item) for (const [stat, value] of Object.entries(itemStats(item))) {
      const key = stat as keyof PlayerStats;
      stats[key] = (stats[key] ?? 0) + value;
    }
  }
  return { stats, ...(content.breads.kosong ? { startBread: content.breads.kosong.id } : {}) };
}
import { freshSave, parseSave } from '../core/save';
import { AFFIX_POOLS, GEAR_BASES, RARITY_INFO } from './gear';
import { unlocksForXp } from './stall';
import { MATERIALS, RARITIES, SLOTS, TRAINING_IDS, UNLOCK_FLAGS, type GearBaseId, type GearItem, type Rarity, type SaveV2 } from './types';

const obj = (value: unknown): Record<string, unknown> => typeof value === 'object' && value !== null && !Array.isArray(value) ? value as Record<string, unknown> : {};
const num = (value: unknown, fallback = 0) => typeof value === 'number' && Number.isFinite(value) && value >= 0 ? value : fallback;
const integer = (value: unknown, max = Number.MAX_SAFE_INTEGER) => Math.min(max, Math.floor(num(value)));
const date = (value: unknown): string | null => typeof value === 'string' && Number.isFinite(Date.parse(value)) ? new Date(value).toISOString() : null;
const calendarDay = (value: unknown): string | null => typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value) && date(value)?.slice(0, 10) === value ? value : null;

export function freshSaveV2(): SaveV2 {
  return {
    ...freshSave(), v: 2, stallXp: 0, inventory: [], equipped: {},
    training: { wrist: 0, stamina: 0, flip: 0 },
    materials: { flour: 0, ghee: 0, egg: 0, onion: 0, spice: 0, sugar: 0, milk: 0 },
    streak: { day: 0, lastClaimDay: null, windowStartDay: null, restDaysUsed: 0 },
    idle: { lastCollectedAt: null }, chestPity: { rare: 0, epic: 0, opened: 0 },
    unlocks: {}, tokens: { reroll: 0, training: 0 },
  };
}
function parseItem(value: unknown): GearItem | null {
  const item = obj(value);
  if (typeof item.uid !== 'string' || !item.uid || typeof item.baseId !== 'string' ||
      !Object.hasOwn(GEAR_BASES, item.baseId) || !RARITIES.includes(item.rarity as Rarity)) return null;
  const baseId = item.baseId as GearBaseId;
  const slot = GEAR_BASES[baseId];
  const rarity = item.rarity as Rarity;
  if (item.slot !== slot || !Number.isSafeInteger(item.level) || num(item.level) < 1 ||
      !Array.isArray(item.affixes) || item.affixes.length !== RARITY_INFO[rarity].affixes) return null;
  // Match by id and take stat/value from current content, so a balance retune never drops an owned item.
  const affixes = item.affixes.map(value => AFFIX_POOLS[slot].find(a => a.id === obj(value).id));
  if (affixes.some(a => !a) || new Set(affixes.map(a => a?.id)).size !== affixes.length) return null;
  return { uid: item.uid, baseId, slot, rarity, level: item.level as number, affixes: affixes.map(a => ({ ...a! })) };
}
/** Storage boundary: unknown versions and garbage are fresh; damaged fields recover independently. */
export function parseSaveV2(json: unknown): SaveV2 {
  const fresh = freshSaveV2();
  if (typeof json !== 'string') return fresh;
  try {
  const raw = obj(JSON.parse(json));
  if (raw.v !== 1 && raw.v !== 2) return fresh;
  const base = parseSave(JSON.stringify({ ...raw, v: 1 }));
  const save: SaveV2 = { ...fresh, ...base, v: 2 };
  if (raw.v === 1) {
    save.idle.lastCollectedAt = date(base.lastPlayed);
    return save;
  }
  save.stallXp = num(raw.stallXp);
  const seen = new Set<string>();
  if (Array.isArray(raw.inventory)) for (const value of raw.inventory) {
    const item = parseItem(value);
    if (item && !seen.has(item.uid)) { save.inventory.push(item); seen.add(item.uid); }
  }
  for (const slot of SLOTS) {
    const uid = obj(raw.equipped)[slot];
    if (save.inventory.some(i => i.uid === uid && i.slot === slot)) save.equipped[slot] = uid as string;
  }
  for (const id of TRAINING_IDS) save.training[id] = integer(obj(raw.training)[id], 5);
  for (const type of MATERIALS) save.materials[type] = integer(obj(raw.materials)[type]);
  const streak = obj(raw.streak);
  const lastClaimDay = calendarDay(streak.lastClaimDay);
  const windowStartDay = calendarDay(streak.windowStartDay);
  if (lastClaimDay && windowStartDay && windowStartDay <= lastClaimDay &&
      (Date.parse(lastClaimDay) - Date.parse(windowStartDay)) / 86400000 < 7) {
    save.streak = { day: Math.max(1, integer(streak.day, 7)), lastClaimDay, windowStartDay, restDaysUsed: integer(streak.restDaysUsed, 2) };
  }
  save.idle.lastCollectedAt = date(obj(raw.idle).lastCollectedAt);
  const pity = obj(raw.chestPity);
  save.chestPity = { rare: integer(pity.rare) % 5, epic: integer(pity.epic) % 20, opened: integer(pity.opened) };
  for (const flag of UNLOCK_FLAGS) if (obj(raw.unlocks)[flag] === true) save.unlocks[flag] = true;
  Object.assign(save.unlocks, unlocksForXp(save.stallXp));
  save.tokens = { reroll: integer(obj(raw.tokens).reroll), training: integer(obj(raw.tokens).training) };
  return save;
  } catch { return fresh; }
}
import type { Rng } from '../core/rng';
import type { RunResult } from '../core/types';
import { rollChest } from './chests';
import { runXp, unlocksForXp } from './stall';
import { MATERIALS, type Material, type SaveV2 } from './types';

export function applyRunResult(save: SaveV2, result: RunResult, rng: Rng, now: Date) {
  // wave is the reached wave; on a loss that wave was not cleared.
  const waves = Math.max(0, result.wave - (result.won ? 0 : 1));
  const gold = 20 + 12 * waves + 60 * result.bossKills;
  const stallXp = runXp(waves, result.bossKills);
  const chest = rollChest(rng, save.chestPity);
  const item = { ...chest.item, uid: `run-${save.runs + 1}-chest-${chest.pity.opened}-${chest.item.uid}` };
  const materials: Partial<Record<Material, number>> = {};
  for (let i = 0; i < Math.floor(waves / 5); i++) {
    const pool = [...MATERIALS];
    for (let j = 0; j < 2; j++) {
      const type = pool.splice(rng.int(0, pool.length - 1), 1)[0];
      materials[type] = (materials[type] ?? 0) + 1;
    }
  }
  const inventoryMaterials = { ...save.materials };
  for (const type of MATERIALS) inventoryMaterials[type] += materials[type] ?? 0;
  const next: SaveV2 = {
    ...save, gold: save.gold + gold, stallXp: save.stallXp + stallXp,
    bestWave: Math.max(save.bestWave, result.wave), runs: save.runs + 1,
    wins: save.wins + Number(result.won), totalKills: save.totalKills + result.kills,
    lastPlayed: now.toISOString(), inventory: [...save.inventory, item], materials: inventoryMaterials,
    chestPity: chest.pity, unlocks: { ...save.unlocks, ...unlocksForXp(save.stallXp + stallXp) },
    idle: save.idle.lastCollectedAt ? { ...save.idle } : { lastCollectedAt: now.toISOString() },
  };
  return { save: next, rewards: { gold, stallXp, chest: item, materials } };
}
import type { UnlockFlag } from './types';

export const LEVEL_THRESHOLDS = [0, 150, 350, 600, 900, 1300, 1800, 2400, 3100, 3900] as const;
export const UNLOCK_TABLE: readonly { level: number; flags: readonly UnlockFlag[] }[] = [
  { level: 2, flags: ['gear', 'towel'] }, { level: 3, flags: ['training', 'headband'] },
  { level: 4, flags: ['secondReroll'] }, { level: 5, flags: ['apron'] },
  { level: 6, flags: ['gloves', 'recipeBook'] }, { level: 7, flags: ['slippers'] },
  { level: 8, flags: ['chefsSpecial'] },
];
export function stallLevel(xp: number): number {
  return 1 + LEVEL_THRESHOLDS.slice(1).filter(t => xp >= t).length;
}
export function nextUnlock(xp: number): { level: number; xpRequired: number; xpRemaining: number; flags: readonly UnlockFlag[] } | null {
  const next = UNLOCK_TABLE.find(u => u.level > stallLevel(xp));
  return next ? { ...next, xpRequired: LEVEL_THRESHOLDS[next.level - 1], xpRemaining: LEVEL_THRESHOLDS[next.level - 1] - Math.max(0, xp) } : null;
}
export function unlocksForXp(xp: number): Partial<Record<UnlockFlag, boolean>> {
  const flags: Partial<Record<UnlockFlag, boolean>> = {};
  for (const u of UNLOCK_TABLE) if (u.level <= stallLevel(xp)) for (const flag of u.flags) flags[flag] = true;
  return flags;
}
export function runXp(wavesCleared: number, bossKills: number): number {
  return 40 + 10 * wavesCleared + 50 * bossKills;
}
import { makeRng } from '../core/rng';
import { rollChest } from './chests';
import { MATERIALS, type GearItem, type Material, type SaveV2 } from './types';

export const STREAK_REWARDS = [
  { gold: 50 }, { reroll: 1 }, { materialCount: 1 }, { gold: 80 },
  { training: 1 }, { materialCount: 2 }, { chest: 'rare' },
] as const;
const DAY_MS = 86400000;
const dayNumber = (day: string) => Date.parse(`${day}T00:00:00Z`) / DAY_MS;
const dayString = (day: number) => new Date(day * DAY_MS).toISOString().slice(0, 10);

/** Offset is minutes east of UTC (Sydney +600), not Date.getTimezoneOffset(). */
export function claim(save: SaveV2, now: Date, tzOffsetMinutes: number) {
  const rewards: { day: number; gold: number; reroll: number; training: number; materials: Partial<Record<Material, number>>; chest: GearItem | null } = {
    day: 0, gold: 0, reroll: 0, training: 0, materials: {}, chest: null,
  };
  const localTime = now.getTime() + tzOffsetMinutes * 60000;
  if (!Number.isFinite(localTime) || Math.abs(tzOffsetMinutes) > 840 || Math.abs(localTime) > 8.64e15) return { save, rewards };
  const today = Math.floor(localTime / DAY_MS);
  const last = save.streak.lastClaimDay ? dayNumber(save.streak.lastClaimDay) : null;
  if (last !== null && today <= last) return { save, rewards };
  const anchor = save.streak.windowStartDay ? dayNumber(save.streak.windowStartDay) : today;
  const currentWindow = Math.floor((today - anchor) / 7);
  let restDaysUsed = currentWindow === 0 ? save.streak.restDaysUsed : 0;
  let penalty = 0;
  if (last !== null && today - last > 1) {
    const start = last + 1;
    const end = today - 1;
    const firstWindow = Math.floor((start - anchor) / 7);
    const finalWindow = Math.floor((end - anchor) / 7);
    const firstCount = Math.min(end + 1, anchor + (firstWindow + 1) * 7) - start;
    const used = firstWindow === 0 ? save.streak.restDaysUsed : 0;
    const firstRest = Math.min(firstCount, 2 - used);
    let absorbed = firstRest;
    if (currentWindow === firstWindow) restDaysUsed = used + firstRest;
    if (finalWindow > firstWindow) {
      absorbed += Math.max(0, finalWindow - firstWindow - 1) * 2;
      const finalRest = Math.min(2, end - (anchor + finalWindow * 7) + 1);
      absorbed += finalRest;
      if (currentWindow === finalWindow) restDaysUsed = finalRest;
    }
    penalty = end - start + 1 - absorbed;
  }
  const previous = last === null ? 0 : Math.max(1, save.streak.day - penalty);
  const day = previous % 7 + 1;
  rewards.day = day;
  const gift = STREAK_REWARDS[day - 1];
  rewards.gold = 'gold' in gift ? gift.gold : 0;
  rewards.reroll = 'reroll' in gift ? gift.reroll : 0;
  rewards.training = 'training' in gift ? gift.training : 0;
  // Login rewards replay from their calendar day; callers need no ambient RNG.
  const rng = makeRng(today ^ save.chestPity.opened);
  const materials = { ...save.materials };
  if ('materialCount' in gift) for (let i = 0; i < gift.materialCount; i++) {
    const type = rng.pick(MATERIALS);
    rewards.materials[type] = (rewards.materials[type] ?? 0) + 1;
    materials[type]++;
  }
  const chest = 'chest' in gift ? rollChest(rng, save.chestPity, 'rare') : null;
  if (chest) rewards.chest = { ...chest.item, uid: `daily-${dayString(today)}-${chest.pity.opened}-${chest.item.uid}` };
  const next: SaveV2 = {
    ...save, gold: save.gold + rewards.gold, materials,
    tokens: { reroll: save.tokens.reroll + rewards.reroll, training: save.tokens.training + rewards.training },
    inventory: rewards.chest ? [...save.inventory, rewards.chest] : [...save.inventory],
    chestPity: chest?.pity ?? { ...save.chestPity },
    streak: { day, lastClaimDay: dayString(today), windowStartDay: dayString(anchor + currentWindow * 7), restDaysUsed },
  };
  return { save: next, rewards };
}
import type { PlayerStats } from '../core/types';
import { TRAINING_IDS, type SaveV2, type TrainingId } from './types';

export const TRAINING_COSTS = [60, 120, 200, 300, 400] as const;
export const TRAINING_STATS: Record<TrainingId, Partial<PlayerStats>> = {
  wrist: { dmgPct: .06 }, stamina: { maxHp: 10 }, flip: { throwSpeedPct: .06 },
};
export function trainingStats(training: SaveV2['training']): Partial<PlayerStats> {
  const stats: Partial<PlayerStats> = {};
  for (const id of TRAINING_IDS) for (const [stat, value] of Object.entries(TRAINING_STATS[id])) {
    const key = stat as keyof PlayerStats;
    stats[key] = (stats[key] ?? 0) + value * training[id];
  }
  return stats;
}
export function buyTraining(save: SaveV2, id: TrainingId): SaveV2 {
  const cost = TRAINING_COSTS[save.training[id]];
  if (!save.unlocks.training || cost === undefined || save.gold < cost) return save;
  return { ...save, gold: save.gold - cost, training: { ...save.training, [id]: save.training[id] + 1 } };
}
export function respec(save: SaveV2): SaveV2 {
  const refund = TRAINING_IDS.reduce((sum, id) => sum + TRAINING_COSTS.slice(0, save.training[id]).reduce<number>((a, b) => a + b, 0), 0);
  return { ...save, gold: save.gold + refund, training: { wrist: 0, stamina: 0, flip: 0 } };
}
import type { SaveV1 } from '../core/save';
import type { PlayerStats } from '../core/types';

export const SLOTS = ['towel', 'headband', 'apron', 'gloves', 'slippers'] as const;
export type Slot = typeof SLOTS[number];
export const RARITIES = ['common', 'uncommon', 'rare', 'epic', 'legendary', 'raja'] as const;
export type Rarity = typeof RARITIES[number];
export type GearBaseId =
  | 'faded-kopitiam-towel' | 'sweat-stained-towel' | 'lucky-red-towel'
  | 'plain-headband' | 'stall-bandana' | 'cooks-hairnet'
  | 'cotton-apron' | 'oil-splashed-apron' | 'denim-apron'
  | 'oven-gloves' | 'silicone-gloves' | 'chefs-gloves'
  | 'rubber-flip-flops' | 'kitchen-clogs' | 'old-house-slippers';
export type Affix = { id: string; stat: keyof PlayerStats; value: number };
export type GearItem = { uid: string; baseId: GearBaseId; slot: Slot; rarity: Rarity; level: number; affixes: Affix[] };
export const MATERIALS = ['flour', 'ghee', 'egg', 'onion', 'spice', 'sugar', 'milk'] as const;
export type Material = typeof MATERIALS[number];
export const TRAINING_IDS = ['wrist', 'stamina', 'flip'] as const;
export type TrainingId = typeof TRAINING_IDS[number];
export const UNLOCK_FLAGS = ['gear', 'training', 'secondReroll', 'recipeBook', 'chefsSpecial', ...SLOTS] as const;
export type UnlockFlag = typeof UNLOCK_FLAGS[number];
export type ChestPity = { rare: number; epic: number; opened: number };
export type StreakState = {
  day: number;
  lastClaimDay: string | null;
  windowStartDay: string | null;
  restDaysUsed: number;
};
export type SaveV2 = Omit<SaveV1, 'v'> & {
  v: 2;
  stallXp: number;
  inventory: GearItem[];
  equipped: Partial<Record<Slot, string>>;
  training: Record<TrainingId, number>;
  materials: Record<Material, number>;
  streak: StreakState;
  idle: { lastCollectedAt: string | null };
  chestPity: ChestPity;
  unlocks: Partial<Record<UnlockFlag, boolean>>;
  tokens: { reroll: number; training: number };
};
import { describe, expect, it } from 'vitest';
import { CONTENT } from '../../content';
import { autoInput, autoPick, simulateRun, type BotOptions } from '../autoplay';
import { chooseCard, createRun, drainEvents, step } from '../sim';
import type { RunResult } from '../types';

/** BALANCE_SEEDS=300 gives the full measurement; the default stays quick. BALANCE_FIRST_SEED=301 runs a holdout range. */
const SEED_COUNT = Number(process.env.BALANCE_SEEDS ?? 20);
const FIRST_SEED = Number(process.env.BALANCE_FIRST_SEED ?? 1);
const SEEDS = Array.from({ length: SEED_COUNT }, (_, i) => FIRST_SEED + i);
const MAX_TIME = 1200;

const median = (xs: number[]): number => {
  const s = [...xs].sort((a, b) => a - b);
  return s.length % 2 ? s[(s.length - 1) / 2] : (s[s.length / 2 - 1] + s[s.length / 2]) / 2;
};
const mean = (xs: number[]): number => xs.reduce((a, b) => a + b, 0) / xs.length;

/** The bot always dodges and stands still; what it picks on level-up is the one knob: how many breads it carries. */
const POLICIES = [
  { name: 'takes new breads (up to 4)', maxBreads: 4 },
  { name: 'takes new breads (up to 2)', maxBreads: 2 },
  { name: 'solo Kosong', maxBreads: 1 },
];

/** Damage Kannan takes from the boss spawn until the boss dies (null when no boss fight happened). */
type Measured = { result: RunResult; bossFightHpLost: number | null; bossAttackHpLost: number | null };

/** The autoplay loop of simulateRun, plus event bookkeeping for the boss fight. */
function measureRun(seed: number, maxBreads: number): Measured {
  const world = createRun({ seed, content: CONTENT });
  const dt = 1 / 30;
  let taken = 0;
  let bossTaken = 0;
  let fight: { start: number; bossStart: number } | null = null;
  let bossFightHpLost: number | null = null;
  let bossAttackHpLost: number | null = null;
  const options: BotOptions = { maxBreads };
  for (let i = 0; i < MAX_TIME * 60 + 1000 && world.phase !== 'won' && world.phase !== 'lost' && world.time < MAX_TIME; i++) {
    if (world.phase === 'levelup') chooseCard(world, autoPick(world, options));
    else step(world, dt, autoInput(world));
    for (const ev of drainEvents(world)) {
      if (ev.t === 'playerHit') {
        taken += ev.dmg;
        if (ev.source === 'boss') bossTaken += ev.dmg;
      } else if (ev.t === 'bossSpawn' && fight === null) {
        fight = { start: taken, bossStart: bossTaken };
      } else if (ev.t === 'kill' && ev.boss && fight !== null && bossFightHpLost === null) {
        bossFightHpLost = taken - fight.start;
        bossAttackHpLost = bossTaken - fight.bossStart;
      }
    }
  }
  const p = world.player;
  const result: RunResult = world.result ?? {
    won: false, wave: world.wave, kills: world.kills, bossKills: world.bossKills, time: world.time, level: p.level, gold: Math.round(world.gold),
    breads: p.breads.map((b) => ({ ...b })), dips: p.dips.map((d) => ({ ...d })),
  };
  return { result, bossFightHpLost, bossAttackHpLost };
}

describe(`balance (autoplay bot, real content, seeds ${FIRST_SEED}..${FIRST_SEED + SEED_COUNT - 1})`, () => {
  it('every run ends before maxTime; prints median wave, win rate, avg level / time / kills and boss-fight HP per pick policy', () => {
    // The reporting loop must be the bot's own loop: same seed, same policy, same result.
    expect(measureRun(1, 4).result).toEqual(simulateRun({ seed: 1, content: CONTENT, maxTime: MAX_TIME, maxBreads: 4 }));
    const lines = [
      '| bot picks | median wave | win rate | avg level | avg time (s) | avg kills | boss HP lost (wins) | of which boss shots |',
      '|---|---|---|---|---|---|---|---|',
    ];
    for (const { name, maxBreads } of POLICIES) {
      const runs = SEEDS.map((seed) => measureRun(seed, maxBreads));
      const results = runs.map((r) => r.result);
      for (const r of results) expect(r.time).toBeLessThan(MAX_TIME);
      const wins = results.filter((r) => r.won).length;
      const fights = runs.filter((r) => r.result.won && r.bossFightHpLost !== null);
      const fightCell = (pick: (r: Measured) => number | null): string => (fights.length ? mean(fights.map((r) => pick(r) ?? 0)).toFixed(0) : '-');
      lines.push(
        `| ${name} | ${median(results.map((r) => r.wave))} | ${Math.round((100 * wins) / results.length)}% | ${mean(results.map((r) => r.level)).toFixed(1)} | ${mean(results.map((r) => r.time)).toFixed(0)} | ${mean(results.map((r) => r.kills)).toFixed(0)} | ${fightCell((r) => r.bossFightHpLost)} | ${fightCell((r) => r.bossAttackHpLost)} |`,
      );
    }
    console.log(lines.join('\n'));
  }, 600_000);
});

