// Prata Raja core model: the contract between content, simulation, renderer and UI.
// Pure data types only. Nothing in src/core may import Phaser, React, the DOM or Expo:
// the core runs headless (tests, balance sims) and identically on web and native.
//
// Field space: the game logic is a flat top-down lane. x runs -270 (left) .. 270 (right);
// y runs 0 (the counter, where Kannan stands) .. 1000 (the horizon, where enemies spawn).
// The renderer projects field space into the over-the-shoulder perspective (src/core/view.ts).
// Units: distances in field units (u), speeds in u/s, time in seconds, percents as fractions (0.1 = 10%).

export const FIELD = {
  halfWidth: 270,
  depth: 1000,
  /** An enemy at y <= reachY is "at the counter" and hurts Kannan. */
  reachY: 30,
  /** Kannan slides within -kannanMaxX..kannanMaxX. */
  kannanMaxX: 230,
  /** Half-width of Kannan's body for enemy projectiles that land on the counter. */
  kannanHitHalfWidth: 34,
} as const;

// ── Ids ──────────────────────────────────────────────────────────────────────

export type BreadId =
  | 'kosong' | 'tissue' | 'roti-bomb' | 'egg-telur' | 'thosai' | 'chapati'
  | 'naan' | 'garlic-naan' | 'murtabak' | 'appam' | 'idli' | 'vadai';
export type DipId =
  | 'fish-curry' | 'condensed-milk' | 'mint-chutney' | 'masala' | 'mutton-curry'
  | 'chicken-curry' | 'sambal' | 'teh-tarik' | 'ghee' | 'dhal';
export type PassiveId =
  | 'strong-wrists' | 'fast-flip' | 'extra-dough' | 'big-dough' | 'hot-tawa' | 'lucky-towel'
  | 'thick-skin' | 'kopi-break' | 'sharp-eye' | 'bigger-tips' | 'multitasker' | 'second-helping';
export type EnemyKind =
  | 'walker' | 'runner' | 'flyer' | 'swarm' | 'tank' | 'shooter' | 'splitter'
  | 'shielded' | 'healer' | 'summoner' | 'exploder';
/** Sprite keys are manifest paths without extension, e.g. 'breads/kosong' (assets/game/manifest.json). */
export type SpriteKey = string;

// ── Content definitions (src/content/*) ─────────────────────────────────────

/** How a bread travels. straight: flies at a target (pierce/hops/fragments/volley ride on it).
 *  lob: arcs to a target point and bursts (blast, optional lingering zone).
 *  wave: a wide bar rolling up the street from Kannan. boomerang: out to range, back to Kannan.
 *  orbit: a ring that circles the counter front, no cooldown. */
export type BreadMotion = 'straight' | 'lob' | 'wave' | 'boomerang' | 'orbit';
/** nearest: closest enemy by field distance. cluster: enemy with most neighbours within blast. none: fires straight up the street. */
export type BreadTarget = 'nearest' | 'cluster' | 'none';

/** Absolute stats for one bread level (L1..L5 each list every field; zero means "not used"). */
export type BreadStats = {
  dmg: number;
  cooldown: number;
  /** Projectile speed (u/s); for lob, ignored (lobTime rules). */
  speed: number;
  /** Projectile hit radius (u). */
  radius: number;
  /** Max distance from the counter it can target or travel (u). */
  range: number;
  /** Shots per throw (idli volley); 1 for most. */
  count: number;
  /** Fan spread between shots of one throw, degrees. */
  spread: number;
  /** Seconds between shots of a volley. */
  volleyGap: number;
  /** Extra enemies passed through after the first hit. */
  pierce: number;
  /** Hops to the next nearest un-hit enemy after a hit (kosong ricochet, appam bounce). */
  hops: number;
  hopRange: number;
  /** Damage multiplier lost per hop (0.15 = -15% per hop). */
  hopFalloff: number;
  /** Egg: fragments spawned on hit, each dealing fragmentDmg. */
  fragments: number;
  fragmentDmg: number;
  /** Lob: blast radius on landing (u) and flight time (s). */
  blast: number;
  lobTime: number;
  /** Lingering zone after landing (garlic naan): seconds and damage per second inside it. */
  zoneTime: number;
  zoneDps: number;
  /** Wave: bar width (u). */
  width: number;
  /** On-hit crowd control. */
  stun: number;
  knockback: number;
  /** Orbit: ring radius (u); hit cooldown per enemy per orb (s). */
  orbitRadius: number;
  orbitHitGap: number;
  /** Fraction of armour/shield ignored (tissue L5). */
  armourPierce: number;
  /** Fragments/projectiles steer toward enemies (0 = no, 1 = strong). */
  homing: number;
};

export type BreadDef = {
  id: BreadId;
  name: string;
  flavor: string;
  sprite: SpriteKey;
  motion: BreadMotion;
  target: BreadTarget;
  /** Exactly 5 entries: L1..L5. */
  levels: BreadStats[];
  /** 'starter' or the recipe id that unlocks it into the run pool (S2+). */
  unlock: 'starter' | string;
};

/** What a dip does when any bread hits. Each dip level is one HitEffect with its numbers. */
export type HitEffect =
  | { type: 'burn'; dps: number; time: number }
  | { type: 'sugar'; slowPct: number; slowTime: number; dpsPerStack: number; stackTime: number; crashAt: number; crashStun: number }
  | { type: 'chill'; slowPerStack: number; time: number; freezeAt: number; freezeTime: number }
  | { type: 'chain'; dmg: number; jumps: number; range: number }
  | { type: 'tender'; knockback: number; dmgTakenPct: number; time: number }
  | { type: 'stackDmg'; pctPerStack: number; maxStacks: number; time: number; critAtMax: number }
  | { type: 'deathBlast'; dmg: number; radius: number }
  | { type: 'haste'; everyHits: number; throwSpeedPct: number; time: number }
  | { type: 'spin'; projSpeedPct: number; critDmgPct: number; time: number }
  | { type: 'healOnKill'; hp: number };

export type DipDef = {
  id: DipId;
  name: string;
  flavor: string;
  sprite: SpriteKey;
  /** Damage-number / tint colour for this dip's effects, '#RRGGBB'. */
  color: string;
  /** Exactly 5 entries: L1..L5. */
  levels: HitEffect[];
  unlock: 'starter' | string;
};

/** Run-time player numbers. Base values in sim; passives, meta and buffs add to them. */
export type PlayerStats = {
  maxHp: number;
  regen: number;
  moveSpeed: number;
  dmgPct: number;
  throwSpeedPct: number;
  critChance: number;
  critMult: number;
  extraProjectiles: number;
  sizePct: number;
  dotPct: number;
  rangePct: number;
  xpPct: number;
  /** Fraction of throw rate kept while moving (Archero rule: 0 = stop to throw). */
  throwWhileMoving: number;
  revives: number;
  dmgTakenPct: number;
  dodge: number;
  healOnLevelUpPct: number;
  goldPct: number;
};

export type PassiveDef = {
  id: PassiveId;
  name: string;
  /** Short card text, e.g. '+6% damage'. */
  desc: string;
  maxLevel: number;
  /** Added to PlayerStats once per level. */
  perLevel: Partial<PlayerStats>;
  sprite: SpriteKey;
};

export type EnemyDef = {
  id: string;
  name: string;
  kind: EnemyKind;
  sprite: SpriteKey;
  /** Wave-1 base HP (the chapter's wave scaling multiplies it). */
  hp: number;
  speed: number;
  contactDps: number;
  xp: number;
  /** Body radius (u) for hits and spacing. */
  radius: number;
  /** Multiplier on knockback received (tank 0.25). */
  knockbackTaken?: number;
  /** Front shield HP that blocks straight/boomerang hits without pierce. */
  shield?: number;
  ranged?: { minY: number; maxY: number; cooldown: number; aimTime: number; dmg: number; projSpeed: number; projSprite: SpriteKey };
  split?: { into: string; count: number };
  heal?: { hps: number; radius: number; minY: number; maxY: number };
  summon?: { id: string; every: number; max: number };
  explode?: { fuse: number; dmg: number; radius: number };
  /** Swarm: spawns as a cloud of this many. */
  cloud?: number;
  /** Runner dash/pause rhythm (s). */
  dash?: { go: number; rest: number; boost: number };
  /** Flyer zigzag amplitude (u) and period (s). */
  zigzag?: { amp: number; period: number };
  weakTo?: string;
};

/** Boss attacks are all dodgeable by sliding left/right. tell = warning time before it lands. */
export type BossAttack =
  | { kind: 'volley'; id: string; name: string; tell: number; cooldown: number; shots: number; spread: number; dmg: number; projSpeed: number; projSprite: SpriteKey }
  | { kind: 'charge'; id: string; name: string; tell: number; cooldown: number; laneWidth: number; dmg: number; speed: number }
  | { kind: 'summon'; id: string; name: string; tell: number; cooldown: number; enemy: string; count: number }
  | { kind: 'rain'; id: string; name: string; tell: number; cooldown: number; marks: number; markWidth: number; dmg: number }
  | { kind: 'sweep'; id: string; name: string; tell: number; cooldown: number; dmg: number };

export type BossDef = EnemyDef & {
  /** HP fractions where the next phase starts, e.g. [0.5]. Each phase speeds attacks up by phaseHaste. */
  phases: number[];
  phaseHaste: number;
  /** Where the boss parks to attack (y). */
  holdY: number;
  attacks: BossAttack[];
};

export type WaveDef = {
  /** Spawn budget in threat points (see ENEMY_COST in waves.ts). */
  budget: number;
  /** Seconds over which the budget is spawned. */
  duration: number;
  /** Enemy id -> relative weight. */
  mix: Record<string, number>;
  /** Chance that a spawned enemy is elite (x3 HP, golden tint). */
  eliteChance: number;
  /** Boss id spawned at the start of this wave (the last wave). */
  boss?: string;
};

export type ChapterDef = {
  id: string;
  name: string;
  background: SpriteKey;
  /** HP multiplier per wave: hp * (1 + hpPerWave * (wave - 1)). */
  hpPerWave: number;
  waves: WaveDef[];
};

export type Content = {
  breads: Record<BreadId, BreadDef>;
  dips: Record<DipId, DipDef>;
  passives: Record<PassiveId, PassiveDef>;
  enemies: Record<string, EnemyDef>;
  bosses: Record<string, BossDef>;
  chapters: ChapterDef[];
  lines: { wake: string[]; win: string[]; tips: string[] };
};

// ── Run state (src/core/sim.ts owns mutation) ───────────────────────────────

export type StatusId = 'burn' | 'sugar' | 'sugarSlow' | 'chill' | 'freeze' | 'stun' | 'tender';

export type Status = {
  id: StatusId;
  /** Seconds left. */
  time: number;
  stacks: number;
  /** Damage per second (burn; sugar = per stack). */
  dps: number;
  /** Slow fraction (sugarSlow/chill per stack) or dmg-taken fraction (tender). */
  amount: number;
};

export type Enemy = {
  uid: number;
  def: EnemyDef | BossDef;
  boss: boolean;
  elite: boolean;
  x: number;
  y: number;
  hp: number;
  maxHp: number;
  shield: number;
  statuses: Status[];
  /** walk: approaching; hold: parked (shooter/healer/boss); attack: at the counter; fuse: exploder ticking. */
  state: 'walk' | 'hold' | 'attack' | 'fuse' | 'dead';
  /** Generic per-state timer (s). */
  t: number;
  /** Seconds since spawn (zigzag phase etc.). */
  age: number;
  /** Pending knockback distance (u) applied over a few frames. */
  knock: number;
  /** Seconds of white hit-flash left (renderer reads it). */
  flash: number;
  /** Boss/shooter attack bookkeeping. */
  cooldowns: Record<string, number>;
  phase: number;
  /** Where a holder parks. */
  holdY: number;
};

export type Projectile = {
  uid: number;
  owner: 'player' | 'enemy';
  sprite: SpriteKey;
  breadId?: BreadId;
  motion: BreadMotion | 'enemy';
  x: number;
  y: number;
  vx: number;
  vy: number;
  /** Lob height 0..1 for the renderer's arc; also the boomerang return flag via `returning`. */
  z: number;
  /** Seconds alive / seconds to live. */
  t: number;
  ttl: number;
  dmg: number;
  radius: number;
  pierceLeft: number;
  hopsLeft: number;
  /** uids already hit (no double hits, except orbit by hitGap). */
  hit: number[];
  returning: boolean;
  targetUid: number | null;
  /** Lob landing point. */
  tx: number;
  ty: number;
  /** Bread level stats snapshot at throw time (null for enemy shots). */
  stats: BreadStats | null;
  /** Spin angle for the renderer (radians). */
  spin: number;
};

export type Zone = { uid: number; x: number; y: number; radius: number; dps: number; time: number; sprite: SpriteKey };

export type OwnedBread = { id: BreadId; level: number; cd: number; volleyLeft: number; volleyT: number };
export type OwnedDip = { id: DipId; level: number };
export type OwnedPassive = { id: PassiveId; level: number };

/** Self-buffs from dips (haste, spin, stackDmg). */
export type Buff = { id: 'haste' | 'spin' | 'stackDmg'; time: number; stacks: number; hitCount: number };

export type Player = {
  x: number;
  targetX: number;
  moving: boolean;
  hp: number;
  stats: PlayerStats;
  breads: OwnedBread[];
  dips: OwnedDip[];
  passives: OwnedPassive[];
  buffs: Buff[];
  level: number;
  xp: number;
  xpToNext: number;
  revivesLeft: number;
  /** Seconds of throw-animation left (renderer pose). */
  throwAnim: number;
  hurtAnim: number;
};

export type Card = {
  kind: 'bread' | 'dip' | 'passive' | 'heal' | 'gold';
  /** BreadId / DipId / PassiveId; '' for heal/gold. */
  id: string;
  /** The level the item becomes if picked (1 = new). */
  level: number;
};

export type GameEvent =
  | { t: 'throw'; breadId: BreadId; x: number }
  | { t: 'hit'; uid: number; x: number; y: number; dmg: number; crit: boolean; color: string | null }
  | { t: 'dot'; uid: number; x: number; y: number; dmg: number; color: string }
  | { t: 'shieldHit'; uid: number; x: number; y: number }
  | { t: 'shieldBreak'; uid: number; x: number; y: number }
  | { t: 'kill'; uid: number; x: number; y: number; enemyId: string; xp: number; boss: boolean; elite: boolean }
  | { t: 'blast'; x: number; y: number; radius: number; color: string | null }
  | { t: 'chain'; points: { x: number; y: number }[] }
  | { t: 'status'; uid: number; status: StatusId }
  | { t: 'aim'; uid: number; x: number; y: number; tx: number; time: number }
  | { t: 'enemyShot'; uid: number }
  | { t: 'splat'; x: number }
  | { t: 'playerHit'; dmg: number; source: 'contact' | 'shot' | 'boss' | 'explode' }
  | { t: 'dodge' }
  | { t: 'heal'; hp: number }
  | { t: 'xp'; amount: number; x: number; y: number }
  | { t: 'levelUp'; level: number }
  | { t: 'waveStart'; wave: number; total: number }
  | { t: 'bossSpawn'; bossId: string; name: string }
  | { t: 'bossTell'; attackId: string; name: string; kind: BossAttack['kind']; xs: number[]; width: number; time: number }
  | { t: 'bossPhase'; phase: number }
  | { t: 'revive' }
  | { t: 'runEnd'; won: boolean };

export type RunPhase = 'intro' | 'wave' | 'levelup' | 'won' | 'lost';

export type RunResult = {
  won: boolean;
  wave: number;
  kills: number;
  bossKills: number;
  time: number;
  level: number;
  gold: number;
  breads: OwnedBread[];
  dips: OwnedDip[];
};

/** Permanent bonuses from the stall (gear, training) applied at run start. S1 passes {}. */
export type Loadout = { stats?: Partial<PlayerStats>; startBread?: BreadId };

export type World = {
  /** Field x of the wave director's last spawn (keeps spawn spacing replayable). */
  lastSpawnX?: number;
  seed: number;
  /** RNG state lives here so a world can be saved and replayed. */
  rngState: number;
  content: Content;
  chapter: ChapterDef;
  time: number;
  phase: RunPhase;
  /** 1-based wave number; 0 before the first wave. */
  wave: number;
  waveTime: number;
  /** Threat points left to spawn this wave and the spawn clock. */
  budgetLeft: number;
  spawnClock: number;
  player: Player;
  enemies: Enemy[];
  projectiles: Projectile[];
  zones: Zone[];
  nextUid: number;
  kills: number;
  bossKills: number;
  gold: number;
  /** Level-ups waiting for a card pick. */
  pendingLevelUps: number;
  offer: Card[];
  rerolls: number;
  /** Events produced since the renderer last drained them. */
  events: GameEvent[];
  result: RunResult | null;
  // Sim-owned extras (optional, so older worlds still load). Set by createRun.
  /** The run's loadout, kept so chooseCard can recompute stats (cards.applyCard needs it). */
  loadout?: Loadout;
  /** Contact damage taken and seconds since the last aggregated 'playerHit' (contact) event. */
  contactAcc?: number;
  contactT?: number;
};

/** What the renderer sends each frame. targetX: field x under the finger while dragging, else null. */
export type RunInput = { targetX: number | null; moving: boolean };
// Level-up cards: what is offered and what a pick does.
// OWNER: swarm builder "cards".
import type { Rng } from './rng';
import { computeStats } from './stats';
import type { BreadId, Card, Content, DipId, Loadout, PassiveId, Player } from './types';

export const MAX_BREADS = 4;
export const MAX_DIPS = 4;
const MAX_LEVEL = 5;

type Candidate = { card: Card; weight: number };

/** Draw `n` (default 3) distinct cards (never two with the same id). Candidates and weights:
 *  owned bread below L5 -> level + 1 (1.2) · new bread from breadPool when breads < MAX_BREADS -> level 1 (0.8)
 *  owned dip below L5 (1.0) · new dip from dipPool when dips < MAX_DIPS (0.8)
 *  passive below its maxLevel, owned or new (0.7).
 *  Guarantee: when the player owns no dip and dipPool is non-empty, at least one card is a new dip.
 *  Pools default to every bread/dip whose unlock is 'starter'. Short of candidates: fill with
 *  { kind: 'heal', id: '', level: 1 } then { kind: 'gold', id: '', level: 1 }. Deterministic for a given rng state. */
export function drawOffer(
  player: Player, content: Content, rng: Rng,
  opts?: { n?: number; breadPool?: BreadId[]; dipPool?: DipId[] },
): Card[] {
  const n = opts?.n ?? 3;
  const breadPool = opts?.breadPool ?? Object.values(content.breads).filter((b) => b.unlock === 'starter').map((b) => b.id).sort();
  const dipPool = opts?.dipPool ?? Object.values(content.dips).filter((d) => d.unlock === 'starter').map((d) => d.id).sort();

  const cands: Candidate[] = [];
  for (const b of player.breads) {
    if (b.level < MAX_LEVEL) cands.push({ card: { kind: 'bread', id: b.id, level: b.level + 1 }, weight: 1.2 });
  }
  if (player.breads.length < MAX_BREADS) {
    for (const id of new Set(breadPool)) {
      if (!player.breads.some((b) => b.id === id)) cands.push({ card: { kind: 'bread', id, level: 1 }, weight: 0.8 });
    }
  }
  for (const d of player.dips) {
    if (d.level < MAX_LEVEL) cands.push({ card: { kind: 'dip', id: d.id, level: d.level + 1 }, weight: 1 });
  }
  if (player.dips.length < MAX_DIPS) {
    for (const id of new Set(dipPool)) {
      if (!player.dips.some((d) => d.id === id)) cands.push({ card: { kind: 'dip', id, level: 1 }, weight: 0.8 });
    }
  }
  for (const p of Object.values(content.passives).sort((a, b) => (a.id < b.id ? -1 : 1))) {
    const level = player.passives.find((o) => o.id === p.id)?.level ?? 0;
    if (level < p.maxLevel) cands.push({ card: { kind: 'passive', id: p.id, level: level + 1 }, weight: 0.7 });
  }

  const offer: Card[] = [];
  const take = (c: Candidate) => {
    cands.splice(cands.indexOf(c), 1);
    offer.push(c.card);
  };
  // Guarantee: a player with no dip is always offered a new one (when the pool has any).
  if (n > 0 && player.dips.length === 0) {
    const newDips = cands.filter((c) => c.card.kind === 'dip');
    if (newDips.length > 0) take(rng.pick(newDips));
  }
  while (offer.length < n && cands.length > 0) take(rng.weighted(cands, (c) => c.weight));
  if (offer.length < n) offer.push({ kind: 'heal', id: '', level: 1 });
  if (offer.length < n) offer.push({ kind: 'gold', id: '', level: 1 });
  return offer;
}

/** Apply a picked card to the player (mutates player): add a new item at level 1 (bread gets cd 0, volleyLeft 0,
 *  volleyT 0) or set the owned item's level to card.level; then recompute player.stats with computeStats(passives,
 *  content, loadout); if maxHp rose, heal by the rise (hp never above maxHp). heal: hp += 30% maxHp (capped).
 *  gold: returns { gold: 25 }. Every other card returns { gold: 0 }. */
export function applyCard(player: Player, card: Card, content: Content, loadout?: Loadout): { gold: number } {
  if (card.kind === 'bread') {
    const owned = player.breads.find((b) => b.id === card.id);
    if (owned) owned.level = card.level;
    else player.breads.push({ id: card.id as BreadId, level: 1, cd: 0, volleyLeft: 0, volleyT: 0 });
  } else if (card.kind === 'dip') {
    const owned = player.dips.find((d) => d.id === card.id);
    if (owned) owned.level = card.level;
    else player.dips.push({ id: card.id as DipId, level: 1 });
  } else if (card.kind === 'passive') {
    const owned = player.passives.find((p) => p.id === card.id);
    if (owned) owned.level = card.level;
    else player.passives.push({ id: card.id as PassiveId, level: 1 });
  }
  const oldMaxHp = player.stats.maxHp;
  player.stats = computeStats(player.passives, content, loadout);
  const rise = Math.max(0, player.stats.maxHp - oldMaxHp);
  player.hp = Math.min(player.stats.maxHp, player.hp + rise);
  if (card.kind === 'heal') player.hp = Math.min(player.stats.maxHp, player.hp + 0.3 * player.stats.maxHp);
  return { gold: card.kind === 'gold' ? 25 : 0 };
}
// A simple bot for balance sims and tests: dodges what is about to land, otherwise stands still and throws.
import { MAX_BREADS } from './cards';
import { chooseCard, createRun, drainEvents, step } from './sim';
import { dangers, type Danger } from './sim/danger';
import { FIELD, type Card, type Content, type Loadout, type RunInput, type RunResult, type World } from './types';

/** Extra clearance around a danger, on top of Kannan's half-width already counted in it. */
const MARGIN = 14;
/** Seconds a danger has to be on screen before the bot reacts (a person needs a moment to see it and drag). */
const REACTION = 0.3;
const GRID = 10;
/** Column picker: field split into bins this wide. */
const BIN = 40;
const BINS = Math.ceil((FIELD.halfWidth * 2) / BIN);

const unsafeAt = (ds: Danger[], x: number): boolean => ds.some((d) => Math.abs(x - d.x) <= d.half + MARGIN);

/** Nearest x that is clear of every danger; if none is clear, the x farthest from the closest edge. */
function safestX(ds: Danger[], from: number): number {
  let best = from;
  let bestCost = Infinity;
  for (let x = -FIELD.kannanMaxX; x <= FIELD.kannanMaxX; x += GRID) {
    if (!unsafeAt(ds, x)) {
      const cost = Math.abs(x - from);
      if (cost < bestCost) {
        best = x;
        bestCost = cost;
      }
    }
  }
  if (bestCost < Infinity) return best;
  let room = -Infinity;
  for (let x = -FIELD.kannanMaxX; x <= FIELD.kannanMaxX; x += GRID) {
    const r = Math.min(...ds.map((d) => Math.abs(x - d.x) - d.half));
    if (r > room) {
      best = x;
      room = r;
    }
  }
  return best;
}

const raw = new Array<number>(BINS).fill(0);
const smooth = new Array<number>(BINS).fill(0);
/** Enemy weight per column bin (closer to the counter counts more), lightly smoothed into neighbours. Returns a shared array. */
function columnScores(w: World): number[] {
  raw.fill(0);
  for (const e of w.enemies) {
    if (e.state === 'dead') continue;
    const bin = Math.min(BINS - 1, Math.max(0, Math.floor((e.x + FIELD.halfWidth) / BIN)));
    raw[bin] += (e.boss ? 3 : 1) / (1 + e.y / 250);
  }
  for (let i = 0; i < BINS; i++) smooth[i] = raw[i] + 0.5 * ((raw[i - 1] ?? 0) + (raw[i + 1] ?? 0));
  return smooth;
}
const binOf = (x: number): number => Math.min(BINS - 1, Math.max(0, Math.floor((x + FIELD.halfWidth) / BIN)));
const binCentre = (bin: number): number => Math.max(-FIELD.kannanMaxX, Math.min(FIELD.kannanMaxX, -FIELD.halfWidth + bin * BIN + BIN / 2));

/** What a player would do this frame. Dodge first (an enemy shot, boss tell or aim lands near Kannan's x), then settle under
 *  the densest enemy column, but only when the gain is clear: moving stops the throwing. */
export function autoInput(w: World): RunInput {
  const p = w.player;
  const ds = dangers(w, REACTION);
  if (ds.length > 0 && (unsafeAt(ds, p.x) || unsafeAt(ds, p.targetX))) {
    const x = safestX(ds, p.x);
    return { targetX: x, moving: Math.abs(x - p.x) > 1 };
  }
  if (Math.abs(p.targetX - p.x) > 1) return { targetX: p.targetX, moving: true };
  const score = columnScores(w);
  let best = 0;
  for (let i = 1; i < BINS; i++) if (score[i] > score[best]) best = i;
  const here = binOf(p.x);
  if (Math.abs(best - here) >= 2 && score[best] >= 1.5 * score[here] + 0.8) {
    const x = binCentre(best);
    if (!unsafeAt(ds, x)) return { targetX: x, moving: true };
  }
  return { targetX: null, moving: false };
}

/** Pick policy. maxBreads: take new bread cards until Kannan holds this many (1 = a solo-Kosong build). */
export type BotOptions = { maxBreads?: number };

const PASSIVE_BONUS: Record<string, number> = {
  'strong-wrists': 8, 'fast-flip': 8, 'extra-dough': 9, 'lucky-towel': 4, 'thick-skin': 5, 'kopi-break': 5, 'big-dough': 3, 'sharp-eye': 2,
};

/** Card value for the bot: bread cards first (upgrades, then new breads while there is room), then new dips, dip upgrades,
 *  passives (damage and speed before the rest); a heal only when low. */
function cardValue(w: World, card: Card, maxBreads: number): number {
  const p = w.player;
  switch (card.kind) {
    case 'bread':
      if (p.breads.some((b) => b.id === card.id)) return 100;
      return p.breads.length < maxBreads ? 95 : 0;
    case 'dip':
      return p.dips.some((d) => d.id === card.id) ? 70 : 80;
    case 'passive':
      return 60 + (PASSIVE_BONUS[card.id] ?? 0);
    case 'heal':
      return p.hp < p.stats.maxHp * 0.4 ? 90 : 30;
    default:
      return 10;
  }
}

/** Index of the card to take from world.offer. */
export function autoPick(w: World, o: BotOptions = {}): number {
  const maxBreads = o.maxBreads ?? MAX_BREADS;
  let best = 0;
  let bestValue = -Infinity;
  w.offer.forEach((card, i) => {
    const v = cardValue(w, card, maxBreads);
    if (v > bestValue) {
      best = i;
      bestValue = v;
    }
  });
  return best;
}

/** One whole run with the bot at 30 steps per second. Ends on win, loss or maxTime sim-seconds (then won = false). */
export function simulateRun(opts: BotOptions & { seed: number; content: Content; maxTime?: number; chapterId?: string; loadout?: Loadout }): RunResult {
  const world = createRun({ seed: opts.seed, content: opts.content, chapterId: opts.chapterId, loadout: opts.loadout });
  const maxTime = opts.maxTime ?? 1200;
  const dt = 1 / 30;
  // The cap only guards against a pick that never resolves (time does not move while a card is pending).
  for (let i = 0; i < maxTime * 60 + 1000 && world.phase !== 'won' && world.phase !== 'lost' && world.time < maxTime; i++) {
    if (world.phase === 'levelup') chooseCard(world, autoPick(world, opts));
    else step(world, dt, autoInput(world));
    drainEvents(world);
  }
  const p = world.player;
  return world.result ?? {
    won: false, wave: world.wave, kills: world.kills, bossKills: world.bossKills, time: world.time, level: p.level, gold: Math.round(world.gold),
    breads: p.breads.map((b) => ({ ...b })), dips: p.dips.map((d) => ({ ...d })),
  };
}
// The run simulation: owns all World mutation. OWNER: the sim engineer.
// Pure TypeScript, no Phaser/React/DOM. Behaviour lives in src/core/sim/*; this file is the step order and the run lifecycle.
// Everything random comes from world.rngState (rebuilt each step, written back at the end), so a run replays from its seed + inputs.
//
// What the renderer can rely on (Projectile fields are reused per motion; no contract change):
//  - straight: radius = hit radius, ttl = range / speed (the path is clipped there). boomerang: returning = on its way back, ty = turn distance.
//  - lob: radius = blast radius, (tx, ty) = landing point, z = arc height 0..1 while t runs to ttl. wave: radius = HALF the bar width, ty = range.
//  - orbit: persistent, targetUid = index on the ring, hit = [uid, time of its last bite, ...]; rebuilt when the bread's level or Kannan's size changes.
//  - enemy shots: motion 'enemy', tx = landing x on the counter, hopsLeft = 1 for boss attacks. Enemy.cooldowns holds sim scratch (keys with _).
//  - fragments are straight projectiles with a stats copy (fragments 0). Zones use sprite 'fx/smoke'.
//  - Kannan.moving is true while he still slides toward targetX (|x - targetX| > 1) as well as while input.moving is set; he throws in neither.
//  - after chooseCard / revive / step the phase is one of intro | wave | levelup | won | lost; events never repeat once drained.
import { applyCard, drawOffer } from './cards';
import { makeRng } from './rng';
import { computeStats, xpToNext } from './stats';
import { tickBuffs } from './status';
import { FIELD, type Content, type GameEvent, type Loadout, type Player, type RunInput, type World } from './types';
import { spawnTick, startWave, waveDone, type SpawnRequest } from './waves';
import { alive, clamp, dirtyMods, emit, type Ctx } from './sim/ctx';
import { flushContact, updateEnemies, updateEnemyShots } from './sim/enemies';
import { updatePlayerShots, updateZones } from './sim/shots';
import { spawnEnemy } from './sim/spawn';
import { updateThrowing } from './sim/throw';

/** Seconds before wave 1 starts. */
const INTRO_TIME = 1.5;
/** step() splits anything longer than this, so physics never takes a huge leap. */
const MAX_DT = 1 / 30;
const MAX_CALL_DT = 5;
const REVIVE_KNOCK = 300;
const REVIVE_RADIUS_Y = 250;

export function createRun(opts: { seed: number; content: Content; chapterId?: string; loadout?: Loadout }): World {
  const { seed, content, loadout } = opts;
  const chapter = content.chapters.find((ch) => ch.id === opts.chapterId) ?? content.chapters[0];
  const stats = computeStats([], content, loadout);
  const player: Player = {
    x: 0, targetX: 0, moving: false, hp: stats.maxHp, stats,
    breads: [{ id: loadout?.startBread ?? 'kosong', level: 1, cd: 0.4, volleyLeft: 0, volleyT: 0 }],
    dips: [], passives: [], buffs: [], level: 1, xp: 0, xpToNext: xpToNext(1), revivesLeft: stats.revives, throwAnim: 0, hurtAnim: 0,
  };
  return {
    seed, rngState: seed >>> 0, content, chapter, time: 0, phase: 'intro', wave: 0, waveTime: 0, budgetLeft: 0, spawnClock: 0,
    player, enemies: [], projectiles: [], zones: [], nextUid: 1, kills: 0, bossKills: 0, gold: 0, pendingLevelUps: 0, offer: [],
    rerolls: 1, events: [], result: null, loadout, contactAcc: 0, contactT: 0,
  };
}

/** Advance by dt seconds (callers pass <= 1/30; split larger steps). Does nothing in 'levelup', 'won', 'lost'.
 *  A longer dt is cut into 1/30 s sub-steps (at most 5 s per call, so a stalled frame can never hang the game). */
export function step(world: World, dt: number, input: RunInput): void {
  let left = Math.min(dt, MAX_CALL_DT);
  while (left > 1e-9) {
    if (world.phase === 'levelup' || world.phase === 'won' || world.phase === 'lost') return;
    const h = Math.min(left, MAX_DT);
    stepOnce(world, h, input);
    left -= h;
  }
}

export function chooseCard(world: World, index: number): void {
  if (world.phase !== 'levelup') return;
  const card = world.offer[index];
  if (!card) return;
  const rng = makeRng(world.rngState);
  const p = world.player;
  const revives = p.stats.revives;
  world.gold += applyCard(p, card, world.content, world.loadout).gold;
  p.revivesLeft += Math.max(0, p.stats.revives - revives); // Second Helping: the new revive is usable at once
  world.pendingLevelUps = Math.max(0, world.pendingLevelUps - 1);
  if (world.pendingLevelUps > 0) {
    world.offer = drawOffer(world.player, world.content, rng);
  } else {
    world.offer = [];
    world.phase = world.wave === 0 ? 'intro' : 'wave';
  }
  world.rngState = rng.state;
}

export function reroll(world: World): boolean {
  if (world.phase !== 'levelup' || world.rerolls <= 0) return false;
  const rng = makeRng(world.rngState);
  world.offer = drawOffer(world.player, world.content, rng);
  world.rerolls--;
  world.rngState = rng.state;
  return true;
}

/** Return and clear world.events. */
export function drainEvents(world: World): GameEvent[] {
  const events = world.events;
  world.events = [];
  return events;
}

// ── One step ─────────────────────────────────────────────────────────────────

function stepOnce(w: World, dt: number, input: RunInput): void {
  const rng = makeRng(w.rngState);
  const c: Ctx = { w, p: w.player, rng, dt, m: null };
  w.time += dt;
  movePlayer(c, input);
  if (w.phase === 'intro' && w.time >= INTRO_TIME) beginWave(c, 1);
  updateThrowing(c);
  updatePlayerShots(c);
  updateZones(c);
  updateEnemies(c);
  updateEnemyShots(c);
  if (c.p.hp <= 0) {
    if (c.p.revivesLeft > 0) revive(c);
    else endRun(c, false);
  }
  if (w.phase === 'wave') runDirector(c);
  sweepDead(w);
  if (w.pendingLevelUps > 0 && (w.phase === 'wave' || w.phase === 'intro')) {
    w.phase = 'levelup';
    w.offer = drawOffer(w.player, w.content, rng);
  }
  w.rngState = rng.state;
}

/** Slide toward the finger, regen, count buffs and animations down. */
function movePlayer(c: Ctx, input: RunInput): void {
  const { p, dt } = c;
  if (input.targetX !== null) p.targetX = clamp(input.targetX, -FIELD.kannanMaxX, FIELD.kannanMaxX);
  const dx = p.targetX - p.x;
  p.moving = input.moving || Math.abs(dx) > 1; // still sliding to targetX counts as moving, finger down or not
  const reach = p.stats.moveSpeed * dt;
  p.x = Math.abs(dx) <= reach ? p.targetX : p.x + Math.sign(dx) * reach;
  if (p.stats.regen > 0 && p.hp > 0) p.hp = Math.min(p.stats.maxHp, p.hp + p.stats.regen * dt);
  tickBuffs(p, dt);
  dirtyMods(c);
  p.throwAnim = Math.max(0, p.throwAnim - dt);
  p.hurtAnim = Math.max(0, p.hurtAnim - dt);
}

// ── Waves ────────────────────────────────────────────────────────────────────

function spawnRequest(c: Ctx, r: SpawnRequest): void {
  const content = c.w.content;
  const def = r.boss ? content.bosses[r.enemyId] : content.enemies[r.enemyId];
  if (!def) return;
  spawnEnemy(c, def, r.x, { elite: r.elite, boss: r.boss });
  if (r.boss) emit(c, { t: 'bossSpawn', bossId: def.id, name: def.name });
}

function beginWave(c: Ctx, wave: number): void {
  const { events, spawns } = startWave(c.w, wave);
  for (const ev of events) emit(c, ev);
  c.w.phase = 'wave';
  for (const r of spawns) spawnRequest(c, r);
}

function runDirector(c: Ctx): void {
  const { w } = c;
  for (const r of spawnTick(w, c.dt, c.rng)) spawnRequest(c, r);
  if (!waveDone(w)) return;
  if (w.wave >= w.chapter.waves.length) endRun(c, true);
  else beginWave(c, w.wave + 1);
}

// ── Death, revive, end ───────────────────────────────────────────────────────

/** Second Helping: half hp, shove everything near the counter back, wipe the enemy shots. */
function revive(c: Ctx): void {
  const { w, p } = c;
  p.revivesLeft--;
  p.hp = p.stats.maxHp * 0.5;
  for (const e of w.enemies) {
    if (alive(e) && e.y < REVIVE_RADIUS_Y) e.knock += REVIVE_KNOCK * (e.boss ? 0.1 : 1);
  }
  let keep = 0;
  for (const s of w.projectiles) if (s.owner !== 'enemy') w.projectiles[keep++] = s;
  w.projectiles.length = keep;
  emit(c, { t: 'revive' });
}

function endRun(c: Ctx, won: boolean): void {
  const { w, p } = c;
  flushContact(c, true);
  w.phase = won ? 'won' : 'lost';
  const cleared = won ? w.chapter.waves.length : Math.max(0, w.wave - 1);
  w.result = {
    won, wave: w.wave, kills: w.kills, bossKills: w.bossKills, time: w.time, level: p.level,
    gold: Math.round(w.gold) + 5 * cleared + (won ? 50 : 0),
    breads: p.breads.map((b) => ({ ...b })), dips: p.dips.map((d) => ({ ...d })),
  };
  emit(c, { t: 'runEnd', won });
}

/** Drop dead enemies and spent projectiles (in place). */
function sweepDead(w: World): void {
  let k = 0;
  for (let i = 0; i < w.enemies.length; i++) if (w.enemies[i].state !== 'dead') w.enemies[k++] = w.enemies[i];
  w.enemies.length = k;
  k = 0;
  for (let i = 0; i < w.projectiles.length; i++) if (w.projectiles[i].ttl >= 0) w.projectiles[k++] = w.projectiles[i];
  w.projectiles.length = k;
}
// Boss behaviour: walk to holdY, then one telegraphed attack at a time (volley, charge, summon, rain, sweep).
// All state lives in Enemy.cooldowns: one timer per attack id, plus _st (0 idle, 1 telling, 2 charging, 3 returning),
// _cur (attack index), _n and _m0.._m(n-1) (the x positions the tell marks), _side (sweep), _rec (pause between attacks).
import { speedMul } from '../status';
import { FIELD, type BossAttack, type BossDef, type Enemy } from '../types';
import { cdGet, clamp, emit, enemyShot, enemySpeed, hurtPlayer, type Ctx } from './ctx';
import { spawnEnemy } from './spawn';

const ST = '_st';
const CUR = '_cur';
const COUNT = '_n';
const SIDE = '_side';
const REC = '_rec';
const mark = (i: number): string => '_m' + i;
/** Seconds of calm after any attack. */
const RECOVER = 0.6;
const LINE_UP_SPEED = 500; // a charging boss slides to its lane during the tell
const CHARGE_SLIDE = 1200;

const attackOf = (e: Enemy): BossAttack => (e.def as BossDef).attacks[cdGet(e, CUR)];

/** The danger the current tell marks on the counter: x centres and the full width of each. Used for the 'bossTell' event and the bot. */
export function tellZones(e: Enemy): { xs: number[]; width: number } {
  const a = attackOf(e);
  const xs: number[] = [];
  for (let i = 0; i < cdGet(e, COUNT); i++) xs.push(cdGet(e, mark(i)));
  switch (a.kind) {
    case 'volley':
      return { xs, width: FIELD.kannanHitHalfWidth * 2 };
    case 'charge':
      return { xs, width: a.laneWidth };
    case 'rain':
      return { xs, width: a.markWidth };
    case 'sweep':
      return { xs, width: FIELD.halfWidth };
    default:
      return { xs, width: 0 };
  }
}

/** Seconds since the current attack's tell began (large once it is past the tell, e.g. mid-charge). */
export const tellAge = (e: Enemy): number => (cdGet(e, ST) === 1 ? attackOf(e).tell - e.t : 99);

/** Cross each hp threshold once: phase++ and a 'bossPhase' event. */
export function bossPhase(c: Ctx, e: Enemy): void {
  const phases = (e.def as BossDef).phases;
  while (e.phase < phases.length && e.hp / e.maxHp <= phases[e.phase]) {
    e.phase++;
    emit(c, { t: 'bossPhase', phase: e.phase });
  }
}

function begin(c: Ctx, e: Enemy, d: BossDef, index: number): void {
  const a = d.attacks[index];
  const cd = e.cooldowns;
  const px = c.p.x;
  cd[ST] = 1;
  cd[CUR] = index;
  e.t = a.tell;
  const xs: number[] = [];
  switch (a.kind) {
    case 'volley':
      for (let j = 0; j < a.shots; j++) xs.push(clamp(px + (j - (a.shots - 1) / 2) * a.spread, -FIELD.halfWidth, FIELD.halfWidth));
      break;
    case 'charge':
      xs.push(px);
      break;
    case 'rain':
      xs.push(px);
      for (let j = 1; j < a.marks; j++) xs.push(c.rng.range(-FIELD.kannanMaxX, FIELD.kannanMaxX));
      break;
    case 'sweep':
      cd[SIDE] = px < 0 ? -1 : 1;
      xs.push((cd[SIDE] * FIELD.halfWidth) / 2);
      break;
    case 'summon':
      xs.push(e.x);
      break;
  }
  cd[COUNT] = xs.length;
  xs.forEach((x, j) => {
    cd[mark(j)] = x;
  });
  const z = tellZones(e);
  emit(c, { t: 'bossTell', attackId: a.id, name: a.name, kind: a.kind, xs: z.xs, width: z.width, time: a.tell });
}

/** Attack done: restart its timer (faster in later phases) and rest a moment. */
function finish(e: Enemy, d: BossDef): void {
  const a = d.attacks[cdGet(e, CUR)];
  e.cooldowns[a.id] = a.cooldown * Math.max(0.25, 1 - d.phaseHaste * e.phase);
  e.cooldowns[REC] = RECOVER;
  e.cooldowns[ST] = 0;
}

function execute(c: Ctx, e: Enemy, d: BossDef, a: BossAttack): void {
  const n = cdGet(e, COUNT);
  switch (a.kind) {
    case 'volley':
      for (let j = 0; j < n; j++) c.w.projectiles.push(enemyShot(c, e.x, e.y, cdGet(e, mark(j)), a.dmg, a.projSpeed, a.projSprite, true));
      emit(c, { t: 'enemyShot', uid: e.uid });
      finish(e, d);
      break;
    case 'charge':
      e.cooldowns[ST] = 2;
      e.state = 'walk';
      break;
    case 'summon': {
      const def = c.w.content.enemies[a.enemy];
      if (def) {
        for (let j = 0; j < a.count; j++) {
          const x = clamp(e.x + (j - (a.count - 1) / 2) * 60, -FIELD.halfWidth, FIELD.halfWidth);
          spawnEnemy(c, def, x, { y: e.y - e.def.radius * 0.5 });
        }
      }
      finish(e, d);
      break;
    }
    case 'rain':
      for (let j = 0; j < n; j++) {
        const x = cdGet(e, mark(j));
        emit(c, { t: 'splat', x });
        if (Math.abs(x - c.p.x) <= a.markWidth / 2) hurtPlayer(c, a.dmg, 'boss');
      }
      finish(e, d);
      break;
    case 'sweep': {
      const side = cdGet(e, SIDE);
      emit(c, { t: 'splat', x: cdGet(e, mark(0)) });
      if (side < 0 ? c.p.x < 0 : c.p.x >= 0) hurtPlayer(c, a.dmg, 'boss');
      finish(e, d);
      break;
    }
  }
}

/** Per step (boss not stunned or frozen). */
export function updateBoss(c: Ctx, e: Enemy): void {
  const d = e.def as BossDef;
  const cd = e.cooldowns;
  const st = cdGet(e, ST);
  if (st === 0) {
    if (e.y > e.holdY + 0.5) {
      e.state = 'walk';
      e.y = Math.max(e.holdY, e.y - enemySpeed(e) * c.dt);
      cd._mt = cdGet(e, '_mt') + c.dt * speedMul(e);
      return;
    }
    e.state = 'hold';
    cd[REC] = Math.max(0, cdGet(e, REC) - c.dt);
    let pick = -1;
    for (let i = 0; i < d.attacks.length; i++) {
      const id = d.attacks[i].id;
      cd[id] = cdGet(e, id) - c.dt;
      if (cd[id] <= 0 && (pick < 0 || cd[id] < cd[d.attacks[pick].id])) pick = i;
    }
    if (pick >= 0 && cd[REC] <= 0) begin(c, e, d, pick);
    return;
  }
  const a = attackOf(e);
  if (st === 1) {
    if (a.kind === 'charge') e.x += clamp(cdGet(e, mark(0)) - e.x, -LINE_UP_SPEED * c.dt, LINE_UP_SPEED * c.dt);
    e.t -= c.dt;
    if (e.t <= 0) execute(c, e, d, a);
  } else if (st === 2 && a.kind === 'charge') {
    const lane = cdGet(e, mark(0));
    e.x += clamp(lane - e.x, -CHARGE_SLIDE * c.dt, CHARGE_SLIDE * c.dt);
    e.y -= a.speed * c.dt;
    if (e.y <= FIELD.reachY) {
      e.y = FIELD.reachY;
      emit(c, { t: 'blast', x: lane, y: 0, radius: a.laneWidth / 2, color: null });
      if (Math.abs(c.p.x - lane) <= a.laneWidth / 2) hurtPlayer(c, a.dmg, 'boss');
      cd[ST] = 3;
    }
  } else {
    // returning to holdY after a charge
    e.y += Math.max(200, d.speed * 4) * c.dt;
    if (e.y >= e.holdY) {
      e.y = e.holdY;
      e.state = 'hold';
      finish(e, d);
    }
  }
}
// Shared plumbing for the sim files: the per-step context, event helper, geometry and the player-damage rule.
import type { Rng } from '../rng';
import { buffMods, type BuffMods } from '../stats';
import { speedMul } from '../status';
import type { Enemy, GameEvent, Player, Projectile, World } from '../types';

export type Ctx = {
  w: World;
  p: Player;
  rng: Rng;
  dt: number;
  /** Cached buff modifiers; null after anything that changes buffs (see dirtyMods). */
  m: BuffMods | null;
};

export const HIT_FLASH = 0.08;
export const SPAWN_Y = 1000;
/** Enemies knocked back never rise above this y. */
export const MAX_ENEMY_Y = 1060;
/** Elite stat multipliers (hp x3 and xp x3 live where they apply). */
export const ELITE_SPEED = 1.1;
export const ELITE_CONTACT = 1.5;

export const emit = (c: Ctx, e: GameEvent): void => {
  c.w.events.push(e);
};
export const newUid = (c: Ctx): number => c.w.nextUid++;
export const clamp = (v: number, lo: number, hi: number): number => (v < lo ? lo : v > hi ? hi : v);
/** Math.hypot is several times slower than this in V8, and these run in the hot loops. */
export const hyp = (x: number, y: number): number => Math.sqrt(x * x + y * y);
export const dist = (ax: number, ay: number, bx: number, by: number): number => hyp(ax - bx, ay - by);
export const alive = (e: Enemy): boolean => e.state !== 'dead';
/** Alive and not already lethally damaged: the only enemies a side effect (chain, blast) may still hurt. */
export const hurtable = (e: Enemy): boolean => e.state !== 'dead' && e.hp > 0;
/** Scratch numbers in Enemy.cooldowns default to 0. */
export const cdGet = (e: Enemy, key: string): number => e.cooldowns[key] ?? 0;

/** Buff modifiers for the current moment (cached until dirtyMods). */
export function mods(c: Ctx): BuffMods {
  if (c.m === null) c.m = buffMods(c.p.buffs, c.p.dips, c.w.content);
  return c.m;
}
export function dirtyMods(c: Ctx): void {
  c.m = null;
}

/** Speed (u/s) an enemy walks at right now, before it knows whether it is walking: def.speed x status slow x elite,
 *  and a runner's dash/rest rhythm (e.t is its cycle clock). */
export function enemySpeed(e: Enemy, slow = speedMul(e)): number {
  let s = e.def.speed * slow * (e.elite ? ELITE_SPEED : 1);
  const d = e.def.dash;
  if (d && d.go + d.rest > 0) s *= e.t % (d.go + d.rest) < d.go ? d.boost : 0;
  return s;
}
/** How fast an enemy is closing in along y (for aim leading). */
export const approachSpeed = (e: Enemy): number => (e.state === 'walk' ? enemySpeed(e) : 0);

/** Hurt Kannan with a shot, blast or boss attack. Shots can be dodged (stats.dodge). Returns true if it landed. */
export function hurtPlayer(c: Ctx, base: number, source: 'shot' | 'boss' | 'explode'): boolean {
  const { p } = c;
  if (p.stats.dodge > 0 && c.rng.chance(p.stats.dodge)) {
    emit(c, { t: 'dodge' });
    return false;
  }
  const dmg = base * (1 + p.stats.dmgTakenPct);
  p.hp -= dmg;
  p.hurtAnim = 0.2;
  emit(c, { t: 'playerHit', dmg, source });
  return true;
}

/** An enemy projectile flying from (x, y) to (tx, 0). tx = landing x; hopsLeft = 1 marks a boss shot. */
export function enemyShot(c: Ctx, x: number, y: number, tx: number, dmg: number, speed: number, sprite: string, boss: boolean): Projectile {
  const d = hyp(tx - x, y) || 1;
  return {
    uid: newUid(c), owner: 'enemy', sprite, motion: 'enemy', x, y, vx: ((tx - x) / d) * speed, vy: (-y / d) * speed, z: 0, t: 0,
    ttl: d / speed + 1, dmg, radius: 8, pierceLeft: 0, hopsLeft: boss ? 1 : 0, hit: [], returning: false, targetUid: null, tx, ty: 0,
    stats: null, spin: 0,
  };
}
// Where the counter is about to be hit: what the autoplay bot (and any "safe spot" hint) dodges.
import { FIELD, type World } from '../types';
import { tellAge, tellZones } from './boss';
import { cdGet } from './ctx';

/** x = centre on the counter, half = half-width of the danger, t = seconds until it lands, age = seconds since it appeared
 *  (a player cannot react before it has been on screen for a moment). */
export type Danger = { x: number; half: number; t: number; age: number };

/** Enemy shots in flight, shooters mid-aim, boss tells and a boss mid-charge, once they have been around for `minAge` seconds. */
export function dangers(w: World, minAge = 0): Danger[] {
  const out: Danger[] = [];
  const add = (d: Danger): void => {
    if (d.age >= minAge) out.push(d);
  };
  for (const s of w.projectiles) {
    if (s.owner === 'enemy' && s.ttl >= 0) add({ x: s.tx, half: FIELD.kannanHitHalfWidth, t: s.y / Math.max(1, Math.abs(s.vy)), age: s.t });
  }
  for (const e of w.enemies) {
    if (e.state === 'dead') continue;
    if (e.boss) {
      const st = cdGet(e, '_st');
      if (st !== 1 && st !== 2) continue;
      const z = tellZones(e);
      if (z.width <= 0) continue;
      for (const x of z.xs) add({ x, half: z.width / 2, t: st === 1 ? e.t : 0, age: tellAge(e) });
    } else if (cdGet(e, '_aim') === 1 && e.def.ranged) {
      add({ x: cdGet(e, '_tx'), half: FIELD.kannanHitHalfWidth, t: e.t + e.y / e.def.ranged.projSpeed, age: e.def.ranged.aimTime - e.t });
    }
  }
  return out;
}
// Enemy behaviour per step: statuses and knockback, the walk/hold/attack state machine for every archetype, and enemy shots.
import { isDisabled, speedMul, tickStatuses } from '../status';
import { FIELD, type Enemy } from '../types';
import { bossPhase, updateBoss } from './boss';
import { alive, cdGet, clamp, dist, ELITE_CONTACT, emit, enemyShot, enemySpeed, hurtPlayer, MAX_ENEMY_Y, type Ctx } from './ctx';
import { DOT_BURN, DOT_SUGAR, dotDamage, flushDot, killEnemy } from './hit';
import { spawnEnemy } from './spawn';

const KNOCK_SPEED = 600;
/** Slack for "at the counter" (the walk clamps enemies to reachY; a shove moves them well off it). */
const AT_COUNTER = 0.5;
const CONTACT_EVERY = 0.5;
const PI2 = Math.PI * 2;

/** Sideways drift while walking: a small wobble, a quick jitter for swarms, the zigzag for flyers (centred on bx). */
function lateralX(e: Enemy): number {
  const mt = cdGet(e, '_mt');
  const bx = cdGet(e, 'bx');
  const ph = cdGet(e, 'ph');
  const z = e.def.zigzag;
  let x: number;
  if (z && e.def.kind === 'flyer') x = bx + z.amp * Math.sin((PI2 * mt) / z.period);
  else if (e.def.kind === 'swarm') x = bx + 10 * Math.sin(mt * 5 + ph) + 6 * Math.sin(mt * 8.3 + 2 * ph);
  else x = bx + 8 * Math.sin(mt * 1.7 + ph);
  return clamp(x, -FIELD.halfWidth, FIELD.halfWidth);
}

/** Contact damage while at the counter. Aggregated into one 'playerHit' per CONTACT_EVERY (flushContact). */
function contact(c: Ctx, e: Enemy): void {
  const dmg = e.def.contactDps * (e.elite ? ELITE_CONTACT : 1) * (1 + c.p.stats.dmgTakenPct) * c.dt;
  if (dmg <= 0) return;
  c.p.hp -= dmg;
  c.p.hurtAnim = 0.2;
  c.w.contactAcc = (c.w.contactAcc ?? 0) + dmg;
}

export function flushContact(c: Ctx, force = false): void {
  const { w } = c;
  w.contactT = (w.contactT ?? 0) + c.dt;
  if (!force && w.contactT < CONTACT_EVERY) return;
  w.contactT = force ? 0 : w.contactT - CONTACT_EVERY;
  const acc = w.contactAcc ?? 0;
  if (acc > 0) emit(c, { t: 'playerHit', dmg: acc, source: 'contact' });
  w.contactAcc = 0;
}

/** Plain walk toward the counter (walker, tank, splitter, shielded, runner, flyer, swarm and the walking half of the rest). */
function walk(c: Ctx, e: Enemy): void {
  if (e.state === 'attack') {
    if (e.y <= FIELD.reachY + AT_COUNTER) {
      contact(c, e);
      return;
    }
    e.state = 'walk';
  }
  const slow = speedMul(e);
  e.cooldowns._mt = cdGet(e, '_mt') + c.dt * slow;
  if (e.def.dash) e.t += c.dt;
  e.y -= enemySpeed(e, slow) * c.dt * (e.def.kind === 'swarm' ? 1 + 0.1 * Math.sin(cdGet(e, '_mt') * 3 + cdGet(e, 'ph')) : 1);
  if (e.def.speed > 0) e.x = lateralX(e);
  if (e.y <= FIELD.reachY) {
    e.y = FIELD.reachY;
    e.state = 'attack';
  }
}

/** Shooters and healers walk to their holdY, then park. True once parked. */
function holdAt(c: Ctx, e: Enemy): boolean {
  if (e.y > e.holdY) {
    const slow = speedMul(e);
    e.cooldowns._mt = cdGet(e, '_mt') + c.dt * slow;
    e.y = Math.max(e.holdY, e.y - enemySpeed(e, slow) * c.dt);
    if (e.def.speed > 0) e.x = lateralX(e);
    e.state = e.y <= e.holdY ? 'hold' : 'walk';
  } else {
    e.state = 'hold';
  }
  return e.state === 'hold';
}

function fireEnemyShot(c: Ctx, e: Enemy, tx: number): void {
  const r = e.def.ranged;
  if (!r) return;
  c.w.projectiles.push(enemyShot(c, e.x, e.y, tx, r.dmg, r.projSpeed, r.projSprite, false));
  emit(c, { t: 'enemyShot', uid: e.uid });
}

function updateShooter(c: Ctx, e: Enemy): void {
  const r = e.def.ranged;
  if (!r) return walk(c, e);
  if (!holdAt(c, e)) return;
  const cd = e.cooldowns;
  if (cdGet(e, '_aim') === 1) {
    e.t -= c.dt;
    if (e.t <= 0) {
      fireEnemyShot(c, e, cdGet(e, '_tx'));
      cd._aim = 0;
      cd._cd = r.cooldown;
    }
  } else {
    cd._cd = cdGet(e, '_cd') - c.dt;
    if (cd._cd <= 0) {
      cd._aim = 1;
      cd._tx = c.p.x;
      e.t = r.aimTime;
      emit(c, { t: 'aim', uid: e.uid, x: e.x, y: e.y, tx: c.p.x, time: r.aimTime });
    }
  }
}

function updateHealer(c: Ctx, e: Enemy): void {
  const h = e.def.heal;
  if (!h) return walk(c, e);
  if (!holdAt(c, e)) return;
  const amount = h.hps * c.dt;
  for (const o of c.w.enemies) {
    if (o === e || !alive(o) || o.hp >= o.maxHp || dist(e.x, e.y, o.x, o.y) > h.radius) continue;
    o.hp = Math.min(o.maxHp, o.hp + amount);
  }
}

function updateSummoner(c: Ctx, e: Enemy): void {
  const s = e.def.summon;
  walk(c, e);
  if (!s) return;
  e.t -= c.dt;
  if (e.t > 0) return;
  e.t = s.every;
  const def = c.w.content.enemies[s.id];
  if (!def) return;
  let near = 0;
  for (const o of c.w.enemies) if (alive(o) && o.def.id === s.id && dist(e.x, e.y, o.x, o.y) <= 250) near++;
  if (near >= s.max) return;
  const side = c.rng.chance(0.5) ? -1 : 1;
  const x = clamp(e.x + side * c.rng.range(30, 60), -FIELD.halfWidth, FIELD.halfWidth);
  spawnEnemy(c, def, x, { y: e.y });
}

function updateExploder(c: Ctx, e: Enemy): void {
  const x = e.def.explode;
  if (!x) return walk(c, e);
  if (e.state === 'fuse') {
    e.t -= c.dt;
    if (e.t <= 0) {
      emit(c, { t: 'blast', x: e.x, y: e.y, radius: x.radius, color: null });
      // it only hurts Kannan if it is still at the counter and he stands inside the blast
      if (e.y <= FIELD.reachY + AT_COUNTER && Math.abs(c.p.x - e.x) <= x.radius) hurtPlayer(c, x.dmg, 'explode');
      e.state = 'dead'; // blows up without a kill: no xp, no gold
    }
    return;
  }
  walk(c, e);
  if (e.state === 'attack') {
    e.state = 'fuse';
    e.t = x.fuse;
  }
}

/** Which dip colours a DoT number: whichever of burn / sugar hurts more right now. */
function dotSource(e: Enemy): number {
  let burn = 0;
  let sugar = 0;
  for (const s of e.statuses) {
    if (s.id === 'burn') burn = s.dps;
    else if (s.id === 'sugar') sugar = s.dps * s.stacks;
  }
  return burn >= sugar ? DOT_BURN : DOT_SUGAR;
}

export function updateEnemies(c: Ctx): void {
  const { w, dt } = c;
  for (let i = 0; i < w.enemies.length; i++) {
    const e = w.enemies[i];
    if (!alive(e)) continue;
    e.age += dt;
    if (e.flash > 0) e.flash = Math.max(0, e.flash - dt);
    if (e.knock > 0) {
      const move = Math.min(e.knock, KNOCK_SPEED * dt);
      e.y = Math.min(e.y + move, MAX_ENEMY_Y);
      e.knock -= move;
    }
    if (e.statuses.length > 0 || cdGet(e, '_da') > 0) {
      const burning = e.statuses.some((s) => s.id === 'burn');
      const src = dotSource(e);
      const dot = tickStatuses(e, dt, c.p.stats.dotPct);
      if (dot > 0) dotDamage(e, dot, src);
      flushDot(c, e);
      if (e.hp <= 0) {
        killEnemy(c, e, burning);
        continue;
      }
    }
    if (e.boss) bossPhase(c, e);
    if (isDisabled(e)) continue;
    if (e.boss) {
      updateBoss(c, e);
      continue;
    }
    switch (e.def.kind) {
      case 'shooter':
        updateShooter(c, e);
        break;
      case 'healer':
        updateHealer(c, e);
        break;
      case 'summoner':
        updateSummoner(c, e);
        break;
      case 'exploder':
        updateExploder(c, e);
        break;
      default:
        walk(c, e);
    }
  }
  flushContact(c);
}

/** Enemy projectiles fly to (tx, 0). On arrival they hit Kannan if he stands within kannanHitHalfWidth of it. */
export function updateEnemyShots(c: Ctx): void {
  const list = c.w.projectiles;
  for (let i = 0; i < list.length; i++) {
    const s = list[i];
    if (s.owner !== 'enemy' || s.ttl < 0) continue;
    s.t += c.dt;
    s.spin += 10 * c.dt;
    s.x += s.vx * c.dt;
    s.y += s.vy * c.dt;
    if (s.y <= 0) {
      s.ttl = -1;
      if (Math.abs(s.tx - c.p.x) <= FIELD.kannanHitHalfWidth) hurtPlayer(c, s.dmg, s.hopsLeft === 1 ? 'boss' : 'shot');
      else emit(c, { t: 'splat', x: s.tx });
    } else if (s.t >= s.ttl) {
      s.ttl = -1;
    }
  }
}
// Damage rules: a bread hit on an enemy, dip chain/sambal side effects, DoT bookkeeping, kills, XP and gold.
import { rollHit, xpToNext } from '../stats';
import { applyHitEffect, dmgTakenMul, hasStatus, onBreadHit } from '../status';
import type { BreadStats, Enemy, HitEffect } from '../types';
import { cdGet, clamp, dirtyMods, dist, emit, HIT_FLASH, hurtable, mods, type Ctx } from './ctx';
import { spawnEnemy } from './spawn';

/** Where a DoT number comes from (picks its colour). */
export const DOT_BURN = 0;
export const DOT_SUGAR = 1;
export const DOT_ZONE = 2;
const DOT_EVERY = 0.5;
const ZONE_COLOR = '#C9D98C';

function stun(c: Ctx, e: Enemy, time: number): void {
  const s = e.statuses.find((x) => x.id === 'stun');
  if (s) s.time = Math.max(s.time, time);
  else {
    e.statuses.push({ id: 'stun', time, stacks: 1, dps: 0, amount: 0 });
    emit(c, { t: 'status', uid: e.uid, status: 'stun' });
  }
}

/** A bread hit lands on e. `shieldable` = a straight/boomerang shot without pierce left: a front shield eats the hit
 *  (no dips, no crit) and the caller must stop the projectile. The bread's armourPierce share of that hit skips the
 *  shield and goes to hp. Returns true when the shield blocked.
 *  Otherwise: damage (crit roll), stun/knockback from the bread, every owned dip, Kannan's hit-buffs, kill check. */
export function hitEnemy(c: Ctx, e: Enemy, dmg: number, st: BreadStats | null, shieldable: boolean): boolean {
  const { w, p } = c;
  if (shieldable && e.shield > 0) {
    const ap = clamp(st ? st.armourPierce : 0, 0, 1);
    const d = rollHit(dmg, p.stats, mods(c), 1, c.rng, false).dmg;
    e.shield = Math.max(0, e.shield - d * (1 - ap));
    e.flash = HIT_FLASH;
    emit(c, { t: 'shieldHit', uid: e.uid, x: e.x, y: e.y });
    if (e.shield <= 0) emit(c, { t: 'shieldBreak', uid: e.uid, x: e.x, y: e.y });
    if (ap > 0) {
      const through = d * ap * dmgTakenMul(e);
      e.hp -= through;
      emit(c, { t: 'hit', uid: e.uid, x: e.x, y: e.y, dmg: through, crit: false, color: null });
      if (e.hp <= 0) killEnemy(c, e);
    }
    return true;
  }
  const r = rollHit(dmg, p.stats, mods(c), dmgTakenMul(e), c.rng);
  e.hp -= r.dmg;
  e.flash = HIT_FLASH;
  emit(c, { t: 'hit', uid: e.uid, x: e.x, y: e.y, dmg: r.dmg, crit: r.crit, color: null });
  if (st) {
    if (st.stun > 0) stun(c, e, st.stun);
    if (st.knockback > 0) e.knock += st.knockback * (e.def.knockbackTaken ?? 1) * (e.boss ? 0.1 : 1);
  }
  for (const d of p.dips) {
    if (e.state === 'dead') break; // a cascade (chain -> sambal) already finished it: no effects on a corpse
    const def = w.content.dips[d.id];
    const fx = def.levels[d.level - 1];
    for (const ev of applyHitEffect(fx, e)) emit(c, ev);
    if (fx.type === 'chain') chain(c, e, fx, def.color);
  }
  onBreadHit(p, w.content);
  dirtyMods(c);
  if (e.hp <= 0) killEnemy(c, e);
  return false;
}

/** Masala: from the hit enemy the spark hops up to `jumps` times, each time to the nearest enemy within `range`
 *  of the last one it touched. Chain damage never crits. */
function chain(c: Ctx, src: Enemy, fx: { dmg: number; jumps: number; range: number }, color: string): void {
  const { w, p } = c;
  const points = [{ x: src.x, y: src.y }];
  const hit: Enemy[] = [];
  let cur = src;
  for (let j = 0; j < fx.jumps; j++) {
    let best: Enemy | null = null;
    let bd = fx.range * fx.range;
    for (const o of w.enemies) {
      if (!hurtable(o) || o === src || hit.includes(o)) continue;
      const dx = o.x - cur.x;
      const dy = o.y - cur.y;
      const d = dx * dx + dy * dy;
      if (d <= bd) {
        best = o;
        bd = d;
      }
    }
    if (!best) break;
    hit.push(best);
    points.push({ x: best.x, y: best.y });
    const r = rollHit(fx.dmg, p.stats, mods(c), dmgTakenMul(best), c.rng, false);
    best.hp -= r.dmg;
    best.flash = HIT_FLASH;
    emit(c, { t: 'hit', uid: best.uid, x: best.x, y: best.y, dmg: r.dmg, crit: false, color });
    cur = best;
  }
  if (points.length > 1) emit(c, { t: 'chain', points });
  for (const o of hit) if (o.hp <= 0) killEnemy(c, o);
}

/** Sambal: a burning enemy dies in a blast that hurts and ignites its neighbours (which may chain-explode). */
function sambalBlast(c: Ctx, src: Enemy, fx: { dmg: number; radius: number }, color: string): void {
  const { w, p } = c;
  emit(c, { t: 'blast', x: src.x, y: src.y, radius: fx.radius, color });
  const fish = p.dips.find((d) => d.id === 'fish-curry');
  const burn: HitEffect = fish ? w.content.dips['fish-curry'].levels[fish.level - 1] : { type: 'burn', dps: 3, time: 2 };
  for (let i = 0; i < w.enemies.length; i++) {
    const o = w.enemies[i];
    if (o === src || !hurtable(o) || dist(src.x, src.y, o.x, o.y) > fx.radius + o.def.radius) continue;
    const r = rollHit(fx.dmg, p.stats, mods(c), dmgTakenMul(o), c.rng, false);
    o.hp -= r.dmg;
    o.flash = HIT_FLASH;
    emit(c, { t: 'hit', uid: o.uid, x: o.x, y: o.y, dmg: r.dmg, crit: false, color });
    for (const ev of applyHitEffect(burn, o)) emit(c, ev);
    if (o.hp <= 0) killEnemy(c, o);
  }
}

// ── DoT bookkeeping ──────────────────────────────────────────────────────────

/** Subtract DoT damage now; the number shown is batched per enemy (Enemy.cooldowns _da amount, _dt timer, _ds source). */
export function dotDamage(e: Enemy, amount: number, src: number): void {
  e.hp -= amount;
  e.cooldowns._da = cdGet(e, '_da') + amount;
  e.cooldowns._ds = src;
}

/** Emit the batched DoT number every 0.5 s (or at once with force, e.g. on death). */
export function flushDot(c: Ctx, e: Enemy, force = false): void {
  const acc = cdGet(e, '_da');
  e.cooldowns._dt = cdGet(e, '_dt') + c.dt;
  if (!force && e.cooldowns._dt < DOT_EVERY) return;
  e.cooldowns._dt = 0;
  if (acc <= 0) return;
  e.cooldowns._da = 0;
  const src = cdGet(e, '_ds');
  const dips = c.w.content.dips;
  const color = src === DOT_BURN ? dips['fish-curry']?.color : src === DOT_SUGAR ? dips['condensed-milk']?.color : ZONE_COLOR;
  emit(c, { t: 'dot', uid: e.uid, x: e.x, y: e.y, dmg: acc, color: color ?? '#FFFFFF' });
}

// ── Kills, XP, gold ──────────────────────────────────────────────────────────

/** Add XP; every threshold crossed is a level-up waiting for a card pick. */
function addXp(c: Ctx, amount: number): void {
  const { p, w } = c;
  p.xp += amount;
  while (p.xp >= p.xpToNext) {
    p.xp -= p.xpToNext;
    p.level++;
    p.xpToNext = xpToNext(p.level);
    w.pendingLevelUps++;
    emit(c, { t: 'levelUp', level: p.level });
    const heal = Math.min(p.stats.healOnLevelUpPct * p.stats.maxHp, p.stats.maxHp - p.hp);
    if (heal > 0 && p.hp > 0) {
      p.hp += heal;
      emit(c, { t: 'heal', hp: heal });
    }
  }
}

/** Kill an enemy (once): rewards, dhal, sambal, splitting. `wasBurning` lets a DoT that just ran out still count. */
export function killEnemy(c: Ctx, e: Enemy, wasBurning?: boolean): void {
  if (e.state === 'dead') return;
  const { w, p } = c;
  const burning = wasBurning ?? hasStatus(e, 'burn');
  e.state = 'dead';
  flushDot(c, e, true);
  w.kills++;
  if (e.boss) w.bossKills++;
  const xp = e.def.xp * (e.elite ? 3 : 1) * (1 + p.stats.xpPct);
  emit(c, { t: 'kill', uid: e.uid, x: e.x, y: e.y, enemyId: e.def.id, xp, boss: e.boss, elite: e.elite });
  emit(c, { t: 'xp', amount: xp, x: e.x, y: e.y });
  addXp(c, xp);
  for (const d of p.dips) {
    const def = w.content.dips[d.id];
    const fx = def.levels[d.level - 1];
    if (fx.type === 'healOnKill' && p.hp > 0) {
      const h = Math.min(fx.hp, p.stats.maxHp - p.hp);
      if (h > 0) {
        p.hp += h;
        emit(c, { t: 'heal', hp: h });
      }
    } else if (fx.type === 'deathBlast' && burning) sambalBlast(c, e, fx, def.color);
  }
  const split = e.def.split;
  const into = split ? w.content.enemies[split.into] : undefined;
  if (split && into) {
    for (let i = 0; i < split.count; i++) {
      const x = e.x + c.rng.range(-30, 30);
      spawnEnemy(c, into, x, { y: Math.max(e.y + c.rng.range(-15, 15), 40) });
    }
  }
  const gold = (e.elite ? 5 : 0) + (e.boss ? 50 : 0) + (c.rng.chance(0.15) ? 1 : 0);
  w.gold += gold * (1 + p.stats.goldPct);
}
// Kannan's projectiles in flight (straight, lob, wave, boomerang, orbit) and the lingering zones they leave.
// A projectile is removed by setting ttl = -1; sim.ts sweeps them out at the end of the step.
// Movement is continuous: every projectile advances by the time it has left in the step, contacts are resolved in the order
// they happen along the path, and range limits clip the last bit of travel, so hits do not depend on the step size.
import type { BreadStats, Enemy, Projectile } from '../types';
import { alive, clamp, dist, emit, hyp, newUid, type Ctx } from './ctx';
import { DOT_ZONE, dotDamage, hitEnemy, killEnemy } from './hit';
import { placeOrb } from './throw';

const HOMING_TURN = 5; // rad/s at homing 1
const FRAGMENT_SPEED = 600;
const FRAGMENT_RADIUS = 8;
const FRAGMENT_TTL = 0.6;
const SPIN_RATE = 14; // rad/s, for the renderer
const OUT_Y = 1060;
const OUT_NEAR_Y = -60;
const OUT_X = 330;
/** How far a wave bar reaches in y around its leading edge, on top of the enemy's radius. */
const WAVE_REACH = 20;
/** A returning boomerang is caught this close to Kannan. */
const CATCH_RADIUS = 30;
/** Time slices shorter than this are rounding dust. */
const TIME_EPS = 1e-9;

/** Where along the segment a->b (0 = a, 1 = b) it first touches a circle of radius r at (ex, ey); 0 when it starts inside; -1 never. */
function contactAt(ax: number, ay: number, bx: number, by: number, ex: number, ey: number, r: number): number {
  const fx = ax - ex;
  const fy = ay - ey;
  const outside = fx * fx + fy * fy - r * r;
  if (outside <= 0) return 0;
  const dx = bx - ax;
  const dy = by - ay;
  const a = dx * dx + dy * dy;
  const b = fx * dx + fy * dy;
  if (a === 0 || b >= 0) return -1; // not moving, or moving away
  const disc = b * b - a * outside;
  if (disc < 0) return -1;
  const t = (-b - Math.sqrt(disc)) / a;
  return t <= 1 ? t : -1;
}

/** The un-hit enemy the segment a->b touches first (ties: the earlier in the list), or null. */
function firstTouched(c: Ctx, s: Projectile, ax: number, ay: number, bx: number, by: number): Enemy | null {
  let best: Enemy | null = null;
  let bt = 2;
  for (const e of c.w.enemies) {
    if (!alive(e) || s.hit.includes(e.uid)) continue;
    const t = contactAt(ax, ay, bx, by, e.x, e.y, s.radius + e.def.radius);
    if (t >= 0 && t < bt) {
      best = e;
      bt = t;
    }
  }
  return best;
}

function nearestUnhit(c: Ctx, x: number, y: number, range: number, hit: number[]): Enemy | null {
  let best: Enemy | null = null;
  let bd = range;
  for (const e of c.w.enemies) {
    if (!alive(e) || hit.includes(e.uid)) continue;
    const d = dist(x, y, e.x, e.y);
    if (d <= bd) {
      best = e;
      bd = d;
    }
  }
  return best;
}

/** Turn the velocity toward the nearest un-hit enemy, at most HOMING_TURN x homing rad/s over `dt`. */
function steer(c: Ctx, s: Projectile, homing: number, dt: number): void {
  let best: Enemy | null = null;
  let bd = Infinity;
  for (const e of c.w.enemies) {
    if (!alive(e) || s.hit.includes(e.uid)) continue;
    const d = (e.x - s.x) ** 2 + (e.y - s.y) ** 2;
    if (d < bd) {
      best = e;
      bd = d;
    }
  }
  if (!best) return;
  const speed = hyp(s.vx, s.vy);
  const cur = Math.atan2(s.vx, s.vy);
  let diff = Math.atan2(best.x - s.x, best.y - s.y) - cur;
  while (diff > Math.PI) diff -= 2 * Math.PI;
  while (diff < -Math.PI) diff += 2 * Math.PI;
  const lim = HOMING_TURN * homing * dt;
  const a = cur + clamp(diff, -lim, lim);
  s.vx = Math.sin(a) * speed;
  s.vy = Math.cos(a) * speed;
}

/** Egg: a ring of small straight fragments from the hit enemy. They carry a stats copy with fragments 0 (no recursion).
 *  `left` is the part of the step still to run after the hit; they fly it at once, so they are never a step ahead or behind. */
function spawnFragments(c: Ctx, s: Projectile, e: Enemy, left: number): void {
  const st = s.stats as BreadStats;
  const n = st.fragments;
  const fst: BreadStats = { ...st, fragments: 0, hops: 0, pierce: 0, stun: 0, knockback: 0, dmg: st.fragmentDmg };
  const a0 = c.rng.range(0, (2 * Math.PI) / n);
  for (let i = 0; i < n; i++) {
    const a = a0 + (2 * Math.PI * i) / n;
    const f: Projectile = {
      uid: newUid(c), owner: 'player', sprite: s.sprite, breadId: s.breadId, motion: 'straight', x: e.x, y: e.y,
      vx: Math.sin(a) * FRAGMENT_SPEED, vy: Math.cos(a) * FRAGMENT_SPEED, z: 0, t: 0, ttl: FRAGMENT_TTL, dmg: st.fragmentDmg,
      radius: FRAGMENT_RADIUS * (1 + c.p.stats.sizePct), pierceLeft: 0, hopsLeft: 0, hit: [e.uid], returning: false,
      targetUid: null, tx: 0, ty: 0, stats: fst, spin: 0,
    };
    c.w.projectiles.push(f);
    flyStraight(c, f, left);
  }
}

/** One straight-shot hit: shield block / pierce / hop / fragments / done. Returns true when the shot flies on (pierced or hopped). */
function straightHit(c: Ctx, s: Projectile, e: Enemy, left: number): boolean {
  const st = s.stats as BreadStats;
  s.hit.push(e.uid);
  if (hitEnemy(c, e, s.dmg, st, s.pierceLeft <= 0)) {
    s.ttl = -1;
    return false;
  }
  if (s.pierceLeft > 0) {
    s.pierceLeft--;
    return true;
  }
  if (s.hopsLeft > 0) {
    const next = nearestUnhit(c, e.x, e.y, st.hopRange, s.hit);
    if (next) {
      const speed = hyp(s.vx, s.vy);
      const a = Math.atan2(next.x - e.x, next.y - e.y);
      s.hopsLeft--;
      s.dmg *= 1 - st.hopFalloff;
      s.x = e.x;
      s.y = e.y;
      s.vx = Math.sin(a) * speed;
      s.vy = Math.cos(a) * speed;
      s.targetUid = next.uid;
      s.ttl = s.t + st.hopRange / speed; // the next enemy is within hopRange, so that is all the leg needs
      return true;
    }
  }
  if (st.fragments > 0) spawnFragments(c, s, e, left);
  s.ttl = -1;
  return false;
}

/** Fly `dt` seconds: each slice runs to the first contact (or the end of the path / lifetime), the hit is resolved, and the
 *  rest of the time carries on from there (pierce, hop, fragments). The path is clipped where the lifetime (= range) ends. */
function flyStraight(c: Ctx, s: Projectile, dt: number): void {
  const st = s.stats as BreadStats;
  let left = dt;
  while (left > TIME_EPS && s.ttl >= 0) {
    const life = s.ttl - s.t;
    if (life <= TIME_EPS) {
      s.ttl = -1;
      return;
    }
    const step = Math.min(left, life);
    if (st.homing > 0 && st.fragments === 0) steer(c, s, st.homing, step);
    const ax = s.x;
    const ay = s.y;
    const bx = ax + s.vx * step;
    const by = ay + s.vy * step;
    const e = firstTouched(c, s, ax, ay, bx, by);
    if (e) {
      const used = step * contactAt(ax, ay, bx, by, e.x, e.y, s.radius + e.def.radius);
      s.x = ax + s.vx * used;
      s.y = ay + s.vy * used;
      s.t += used;
      left -= used;
      if (!straightHit(c, s, e, left)) return;
    } else {
      s.x = bx;
      s.y = by;
      s.t += step;
      left -= step;
      if (s.y > OUT_Y || s.y < OUT_NEAR_Y || Math.abs(s.x) > OUT_X || s.t >= s.ttl - TIME_EPS) {
        s.ttl = -1;
        return;
      }
    }
  }
}

function land(c: Ctx, s: Projectile): void {
  const { w } = c;
  const st = s.stats as BreadStats;
  s.x = s.tx;
  s.y = s.ty;
  s.z = 0;
  emit(c, { t: 'blast', x: s.tx, y: s.ty, radius: s.radius, color: null });
  const n = w.enemies.length; // enemies born from these kills (splitters) are not caught by the same blast
  for (let i = 0; i < n; i++) {
    const e = w.enemies[i];
    if (alive(e) && dist(s.tx, s.ty, e.x, e.y) <= s.radius + e.def.radius) hitEnemy(c, e, s.dmg, st, false);
  }
  if (st.zoneTime > 0) {
    w.zones.push({ uid: newUid(c), x: s.tx, y: s.ty, radius: s.radius, dps: st.zoneDps, time: st.zoneTime, sprite: 'fx/smoke' });
  }
  s.ttl = -1;
}

function updateLob(c: Ctx, s: Projectile): void {
  s.t += c.dt;
  s.x += s.vx * c.dt;
  s.y += s.vy * c.dt;
  const u = Math.min(1, s.t / s.ttl);
  s.z = 4 * u * (1 - u);
  if (s.t >= s.ttl) land(c, s);
}

/** Wave bar: its leading edge sweeps y0..y1 this step (never past ty = range). Every enemy in line with it whose reach
 *  window (radius + WAVE_REACH) the edge crosses is hit once, in the order the edge reaches them. */
function flyWave(c: Ctx, s: Projectile, dt: number): void {
  const st = s.stats as BreadStats;
  const y0 = s.y;
  const y1 = Math.min(y0 + s.vy * dt, s.ty);
  for (;;) {
    let best: Enemy | null = null;
    let bt = Infinity;
    for (const e of c.w.enemies) {
      if (!alive(e) || s.hit.includes(e.uid)) continue;
      const reach = e.def.radius + WAVE_REACH;
      if (Math.abs(e.x - s.x) > s.radius + e.def.radius || e.y - reach > y1 || e.y + reach < y0) continue;
      const t = Math.max(0, e.y - reach - y0);
      if (t < bt) {
        best = e;
        bt = t;
      }
    }
    if (!best) break;
    s.hit.push(best.uid);
    hitEnemy(c, best, s.dmg, st, false);
  }
  s.t += (y1 - y0) / s.vy;
  s.y = y1;
  if (y1 >= s.ty - TIME_EPS) s.ttl = -1;
}

/** Boomerang: out along its heading for ty (= range) u, then home to Kannan's current spot until it is within CATCH_RADIUS.
 *  Each leg is flown in slices that end exactly at the turn / the catch point, and a slice's hits are resolved before the
 *  turn clears the hit list or the catch removes the projectile. An enemy is hit once per direction. */
function flyBoomerang(c: Ctx, s: Projectile, dt: number): void {
  const { p } = c;
  const st = s.stats as BreadStats;
  const speed = hyp(s.vx, s.vy);
  let left = dt;
  while (left > TIME_EPS && s.ttl >= 0) {
    let reach: number; // how far this leg still goes before it turns / is caught
    if (!s.returning) {
      reach = s.ty - speed * s.t;
    } else {
      const dx = p.x - s.x;
      const dy = -s.y;
      const d = hyp(dx, dy);
      if (d <= CATCH_RADIUS) {
        s.ttl = -1;
        return;
      }
      s.vx = (dx / d) * speed;
      s.vy = (dy / d) * speed;
      reach = d - CATCH_RADIUS;
    }
    const toEvent = Math.max(0, reach) / speed;
    const slice = Math.min(left, toEvent);
    const ax = s.x;
    const ay = s.y;
    const bx = ax + s.vx * slice;
    const by = ay + s.vy * slice;
    for (let e = firstTouched(c, s, ax, ay, bx, by); e; e = firstTouched(c, s, ax, ay, bx, by)) {
      s.hit.push(e.uid);
      if (hitEnemy(c, e, s.dmg, st, true)) {
        s.ttl = -1;
        return;
      }
    }
    s.x = bx;
    s.y = by;
    s.t += slice;
    const arrived = toEvent <= left;
    left -= slice;
    if (arrived) {
      if (s.returning) {
        s.ttl = -1;
        return;
      }
      s.returning = true;
      s.hit.length = 0;
    }
  }
  if (s.t >= s.ttl) s.ttl = -1;
}

/** Orbit: the orb rides its ring and bites anything it touches. s.hit is a flat list [uid, time of last bite, ...]: an enemy
 *  that is still cooling down (less than orbitHitGap since this orb bit it) is skipped, so each orb has its own clock per enemy. */
function updateOrbit(c: Ctx, s: Projectile): void {
  const st = s.stats as BreadStats;
  s.t += c.dt;
  placeOrb(c, s);
  const gap = st.orbitHitGap > 0 ? st.orbitHitGap : 0.5;
  const now = c.w.time;
  const h = s.hit;
  for (let i = h.length - 2; i >= 0; i -= 2) if (now - h[i + 1] >= gap - TIME_EPS) h.splice(i, 2);
  for (let i = 0; i < c.w.enemies.length; i++) {
    const e = c.w.enemies[i];
    if (!alive(e) || dist(s.x, s.y, e.x, e.y) >= s.radius + e.def.radius) continue;
    let cooling = false;
    for (let k = 0; k < h.length; k += 2) if (h[k] === e.uid) cooling = true;
    if (cooling) continue;
    h.push(e.uid, now);
    hitEnemy(c, e, s.dmg, st, false);
  }
}

export function updatePlayerShots(c: Ctx): void {
  const list = c.w.projectiles;
  const n = list.length; // fragments born during the pass already flew their share of it
  for (let i = 0; i < n; i++) {
    const s = list[i];
    if (s.owner !== 'player' || s.ttl < 0) continue;
    s.spin += SPIN_RATE * c.dt;
    switch (s.motion) {
      case 'straight':
        flyStraight(c, s, c.dt);
        break;
      case 'lob':
        updateLob(c, s);
        break;
      case 'wave':
        flyWave(c, s, c.dt);
        break;
      case 'boomerang':
        flyBoomerang(c, s, c.dt);
        break;
      case 'orbit':
        updateOrbit(c, s);
        break;
      default:
        break;
    }
  }
}

/** Zones burn everything inside them (no crit); expired ones are dropped. */
export function updateZones(c: Ctx): void {
  const { w, dt } = c;
  let keep = 0;
  for (let i = 0; i < w.zones.length; i++) {
    const z = w.zones[i];
    const live = Math.min(dt, z.time);
    z.time -= dt;
    const dmg = z.dps * (1 + c.p.stats.dotPct) * live;
    if (dmg > 0) {
      for (let k = 0; k < w.enemies.length; k++) {
        const e = w.enemies[k];
        if (!alive(e) || dist(z.x, z.y, e.x, e.y) > z.radius + e.def.radius) continue;
        dotDamage(e, dmg, DOT_ZONE);
        if (e.hp <= 0) killEnemy(c, e);
      }
    }
    if (z.time > 0) w.zones[keep++] = z;
  }
  w.zones.length = keep;
}
// Turning defs and wave-director requests into living enemies.
import { waveHpScale } from '../stats';
import { FIELD, type BossDef, type Enemy, type EnemyDef } from '../types';
import { clamp, newUid, SPAWN_Y, type Ctx } from './ctx';

/** Create one enemy and add it to the world. hp and shield scale with the wave (x3 for elites).
 *  Scratch numbers in cooldowns: bx = spawn x (walk wobble / zigzag centre), ph = wobble phase,
 *  _mt = movement clock (advances only while walking). Shooters also get _cd, bosses one timer per attack id. */
export function spawnEnemy(c: Ctx, def: EnemyDef | BossDef, x: number, opts: { y?: number; elite?: boolean; boss?: boolean } = {}): Enemy {
  const { w, rng } = c;
  const elite = opts.elite ?? false;
  const boss = opts.boss ?? false;
  const y = opts.y ?? SPAWN_Y + rng.range(0, 40);
  const scale = waveHpScale(w.chapter, Math.max(1, w.wave)) * (elite ? 3 : 1);
  const hp = def.hp * scale;
  const cd: Record<string, number> = { bx: x, ph: rng.range(0, Math.PI * 2), _mt: 0 };
  const e: Enemy = {
    uid: newUid(c), def, boss, elite, x, y, hp, maxHp: hp, shield: (def.shield ?? 0) * scale,
    statuses: [], state: 'walk', t: 0, age: 0, knock: 0, flash: 0, cooldowns: cd, phase: 0, holdY: 0,
  };
  if (def.zigzag) cd.bx = clamp(x, -(FIELD.halfWidth - def.zigzag.amp), FIELD.halfWidth - def.zigzag.amp);
  if (def.dash && def.kind === 'runner') e.t = rng.range(0, def.dash.go + def.dash.rest);
  if (def.summon) e.t = def.summon.every * 0.5;
  if (def.ranged) {
    e.holdY = rng.range(def.ranged.minY, def.ranged.maxY);
    cd._cd = def.ranged.cooldown * rng.range(0.3, 1);
  }
  if (def.heal) e.holdY = rng.range(def.heal.minY, def.heal.maxY);
  if (boss) {
    const b = def as BossDef;
    e.holdY = b.holdY;
    b.attacks.forEach((a, i) => {
      cd[a.id] = a.cooldown * (0.5 + 0.3 * i);
    });
  }
  w.enemies.push(e);
  return e;
}
// Kannan's throwing: cooldowns, targeting, volleys and what each bread motion launches. Orbit breads keep their orbs alive here.
import { effectiveCooldown } from '../stats';
import { FIELD, type BreadDef, type BreadMotion, type BreadStats, type Enemy, type OwnedBread, type Projectile } from '../types';
import { alive, approachSpeed, clamp, emit, hyp, mods, newUid, type Ctx } from './ctx';

const RAD = Math.PI / 180;
/** extraProjectiles fan out this far apart. */
const FAN = 12 * RAD;
const THROW_ANIM = 0.18;
/** Orbit rings circle this field point in front of Kannan. */
const ORBIT_Y = 90;

function base(c: Ctx, def: BreadDef, st: BreadStats, motion: BreadMotion): Projectile {
  return {
    uid: newUid(c), owner: 'player', sprite: def.sprite, breadId: def.id, motion, x: c.p.x, y: 0, vx: 0, vy: 0, z: 0, t: 0, ttl: 1,
    dmg: st.dmg, radius: st.radius, pierceLeft: 0, hopsLeft: 0, hit: [], returning: false, targetUid: null, tx: 0, ty: 0, stats: st, spin: 0,
  };
}

// ── Targeting ────────────────────────────────────────────────────────────────

/** Closest living enemy to (player.x, 0) within range (first found wins ties). */
function nearestInRange(c: Ctx, range: number): Enemy | null {
  const { w, p } = c;
  let best: Enemy | null = null;
  let bd = range * range;
  for (const e of w.enemies) {
    if (!alive(e)) continue;
    const dx = e.x - p.x;
    const d2 = dx * dx + e.y * e.y;
    if (best === null ? d2 <= bd : d2 < bd) {
      best = e;
      bd = d2;
    }
  }
  return best;
}

function anyInRange(c: Ctx, range: number): boolean {
  const r2 = range * range;
  for (const e of c.w.enemies) {
    const dx = e.x - c.p.x;
    if (alive(e) && dx * dx + e.y * e.y <= r2) return true;
  }
  return false;
}

/** The `n` best in-range enemies to bomb: most living neighbours within `blast` first, ties nearest first. Later picks
 *  prefer enemies outside the blast of the earlier ones (so extra bombs find another cluster), then anything left. */
function clusterTargets(c: Ctx, range: number, blast: number, n: number): Enemy[] {
  const { w, p } = c;
  const r2 = range * range;
  const cands: Enemy[] = [];
  const score: number[] = [];
  const near: number[] = [];
  for (const e of w.enemies) {
    const dx = e.x - p.x;
    const d2 = dx * dx + e.y * e.y;
    if (!alive(e) || d2 > r2) continue;
    let s = 0;
    for (const o of w.enemies) {
      if (o !== e && alive(o) && hyp(o.x - e.x, o.y - e.y) <= blast) s++;
    }
    cands.push(e);
    score.push(s);
    near.push(d2);
  }
  const out: Enemy[] = [];
  const used = new Set<number>();
  const clear = (i: number): boolean => out.every((o) => hyp(o.x - cands[i].x, o.y - cands[i].y) > blast);
  while (out.length < n && out.length < cands.length) {
    let bi = -1;
    for (const needClear of [true, false]) {
      for (let i = 0; i < cands.length; i++) {
        if (used.has(i) || (needClear && !clear(i))) continue;
        if (bi < 0 || score[i] > score[bi] || (score[i] === score[bi] && near[i] < near[bi])) bi = i;
      }
      if (bi >= 0) break;
    }
    used.add(bi);
    out.push(cands[bi]);
  }
  return out;
}

/** Angle (0 = straight up the street, + = right) that meets the enemy: it walks toward Kannan while the shot flies. */
function aimAngle(c: Ctx, e: Enemy, speed: number): number {
  const px = c.p.x;
  const vs = approachSpeed(e);
  let ty = e.y;
  let t = hyp(e.x - px, ty) / speed;
  for (let i = 0; i < 3; i++) {
    ty = Math.max(FIELD.reachY, e.y - vs * t);
    t = hyp(e.x - px, ty) / speed;
  }
  return Math.atan2(e.x - px, ty);
}

// ── Launching ────────────────────────────────────────────────────────────────

function spawnStraight(c: Ctx, def: BreadDef, st: BreadStats, motion: 'straight' | 'boomerang', ang: number, speed: number, range: number, target: Enemy | null): void {
  const s = base(c, def, st, motion);
  s.vx = Math.sin(ang) * speed;
  s.vy = Math.cos(ang) * speed;
  s.radius = st.radius * (1 + c.p.stats.sizePct);
  s.targetUid = target ? target.uid : null;
  if (motion === 'straight') {
    s.pierceLeft = st.pierce;
    s.hopsLeft = st.hops;
    s.ttl = range / speed; // exactly the range: shots.ts clips the last bit of travel, so nothing lands beyond it
  } else {
    s.ty = range; // boomerang: how far out it flies before turning
    s.ttl = (2 * range) / speed + 3;
  }
  c.w.projectiles.push(s);
}

/** Thosai: a bar that rolls up the street. radius = half its width (extra projectiles widen it instead of multiplying it),
 *  ty = how far up it rolls (its range). */
function spawnWave(c: Ctx, def: BreadDef, st: BreadStats, speed: number, range: number): void {
  const s = base(c, def, st, 'wave');
  s.vy = speed;
  s.radius = (st.width * (1 + c.p.stats.sizePct) * (1 + 0.25 * c.p.stats.extraProjectiles)) / 2;
  s.ty = range;
  s.ttl = range / speed;
  c.w.projectiles.push(s);
}

/** Roti Bomb / Naan: arcs to where the enemy will be when it lands. radius = blast radius. */
function spawnLob(c: Ctx, def: BreadDef, st: BreadStats, target: Enemy): void {
  const s = base(c, def, st, 'lob');
  const time = Math.max(0.05, st.lobTime);
  s.tx = clamp(target.x, -FIELD.halfWidth, FIELD.halfWidth);
  s.ty = Math.max(FIELD.reachY, target.y - approachSpeed(target) * time);
  s.vx = (s.tx - c.p.x) / time;
  s.vy = s.ty / time;
  s.ttl = time;
  s.radius = st.blast * (1 + c.p.stats.sizePct);
  s.targetUid = target.uid;
  c.w.projectiles.push(s);
}

/** Launch `members` volley members (numbers m0..m0+members-1 of st.count) at once. False when there is nothing to hit. */
function throwMembers(c: Ctx, def: BreadDef, st: BreadStats, m0: number, members: number): boolean {
  const { p } = c;
  const range = st.range * (1 + p.stats.rangePct);
  const extra = p.stats.extraProjectiles;
  const speed = Math.max(1, st.speed * (1 + mods(c).projSpeedPct));
  switch (def.motion) {
    case 'lob': {
      const n = members * (1 + extra);
      const targets = clusterTargets(c, range, def.target === 'cluster' ? st.blast * (1 + p.stats.sizePct) : 0, n);
      if (targets.length === 0) return false;
      for (let i = 0; i < n; i++) spawnLob(c, def, st, targets[i % targets.length]);
      return true;
    }
    case 'wave': {
      if (!anyInRange(c, range)) return false;
      for (let i = 0; i < members; i++) spawnWave(c, def, st, speed, range);
      return true;
    }
    case 'straight':
    case 'boomerang': {
      let target: Enemy | null = null;
      let a0 = 0;
      if (def.target === 'none') {
        if (!anyInRange(c, range)) return false;
      } else {
        target = nearestInRange(c, range);
        if (!target) return false;
        a0 = aimAngle(c, target, speed);
      }
      for (let m = 0; m < members; m++) {
        const vol = st.count > 1 ? (m0 + m - (st.count - 1) / 2) * st.spread * RAD : 0;
        for (let j = 0; j <= extra; j++) {
          spawnStraight(c, def, st, def.motion, a0 + vol + (j - extra / 2) * FAN, speed, range, target);
        }
      }
      return true;
    }
    default:
      return false;
  }
}

/** First shot of a throw. Volley members after the first follow every volleyGap (see continueVolley). */
function tryFire(c: Ctx, b: OwnedBread, def: BreadDef, st: BreadStats): boolean {
  const together = st.volleyGap <= 0 ? Math.max(1, st.count) : 1;
  if (!throwMembers(c, def, st, 0, together)) return false;
  if (st.volleyGap > 0 && st.count > 1) {
    b.volleyLeft = st.count - 1;
    b.volleyT = st.volleyGap;
  }
  return true;
}

/** Remaining volley members leave every volleyGap, even while Kannan moves; each re-aims. */
function continueVolley(c: Ctx, b: OwnedBread, def: BreadDef, st: BreadStats): void {
  b.volleyT -= c.dt;
  const gap = Math.max(st.volleyGap, 0.02);
  while (b.volleyLeft > 0 && b.volleyT <= 0) {
    const m = clamp(st.count - b.volleyLeft, 1, Math.max(1, st.count - 1));
    if (!throwMembers(c, def, st, m, 1)) {
      b.volleyLeft = 0;
      return;
    }
    b.volleyLeft--;
    b.volleyT += gap;
  }
}

// ── Orbit ────────────────────────────────────────────────────────────────────

/** Put an orb on its ring: evenly spaced, turning st.speed degrees per second (orb index in targetUid). */
export function placeOrb(c: Ctx, s: Projectile): void {
  const st = s.stats as BreadStats;
  const n = Math.max(1, st.count + c.p.stats.extraProjectiles);
  const ang = (2 * Math.PI * (s.targetUid ?? 0)) / n + st.speed * RAD * c.w.time;
  s.x = c.p.x + st.orbitRadius * Math.cos(ang);
  s.y = ORBIT_Y + st.orbitRadius * Math.sin(ang);
}

/** Keep exactly count + extraProjectiles orbs alive for an orbit bread; rebuild them when its level or size changes.
 *  Orb fields: targetUid = index on the ring, pierceLeft = bread level when built, hit = [uid, last bite time, ...] (shots.ts). */
function syncOrbs(c: Ctx, b: OwnedBread, def: BreadDef, st: BreadStats): void {
  const n = Math.max(1, st.count + c.p.stats.extraProjectiles);
  const radius = st.radius * (1 + c.p.stats.sizePct);
  let have = 0;
  let stale = false;
  for (const s of c.w.projectiles) {
    if (s.motion !== 'orbit' || s.breadId !== b.id || s.ttl < 0) continue;
    have++;
    if (s.pierceLeft !== b.level || s.radius !== radius) stale = true;
  }
  if (have === n && !stale) return;
  for (const s of c.w.projectiles) if (s.motion === 'orbit' && s.breadId === b.id) s.ttl = -1;
  for (let i = 0; i < n; i++) {
    const s = base(c, def, st, 'orbit');
    s.radius = radius;
    s.pierceLeft = b.level;
    s.targetUid = i;
    s.ttl = 1e9;
    placeOrb(c, s);
    c.w.projectiles.push(s);
  }
}

// ── Per-step entry ───────────────────────────────────────────────────────────

/** Count every bread's cooldown down and throw. Archero rule: cooldowns only run at throwWhileMoving x rate while Kannan moves. */
export function updateThrowing(c: Ctx): void {
  const { p, w } = c;
  const rate = p.moving ? p.stats.throwWhileMoving : 1;
  for (const b of p.breads) {
    const def = w.content.breads[b.id];
    const st = def.levels[b.level - 1];
    if (def.motion === 'orbit') {
      syncOrbs(c, b, def, st);
      continue;
    }
    if (b.volleyLeft > 0) continueVolley(c, b, def, st);
    if (b.volleyLeft > 0) {
      // a new throw waits for the unfinished volley; the cooldown that ran out meanwhile is not banked
      b.cd = Math.max(0, b.cd - c.dt * rate);
      continue;
    }
    b.cd -= c.dt * rate;
    if (b.cd > 0 || rate <= 0) continue;
    if (tryFire(c, b, def, st)) {
      b.cd += effectiveCooldown(st.cooldown, p.stats, mods(c));
      p.throwAnim = THROW_ANIM;
      emit(c, { t: 'throw', breadId: b.id, x: p.x });
    } else {
      b.cd = 0;
    }
  }
}

