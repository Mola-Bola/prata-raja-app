# Local Supabase (the Mac's test bench: bash scripts/dev-up.sh). Copy to .env and fill in the key from `supabase status`
# (the "Publishable" key). The LAN IP lets phones and emulators reach the Mac; use 127.0.0.1 for the web only.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:59521
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_WEB_URL=http://127.0.0.1:9490

# Production values live in .env.production (the cloud project's URL and publishable key, baked into shipped bundles)
# and .env.cloud (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY for scripts only). Neither is ever committed or pasted
# into a chat; see docs/UPDATES.md.

# Analytics, replay and error tracking inside the game (src/game/telemetry.ts) are on only when BOTH are set, so dev builds and
# tests send nothing and leave these empty. Production values (the fam-relay proxy and the PostHog project key, both public) go in
# .env.production (OTA and web bundles) and eas.json (APK builds). See docs/TELEMETRY.md.
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_POSTHOG_KEY=
